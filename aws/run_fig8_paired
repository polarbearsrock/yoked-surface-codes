#!/usr/bin/env bash

# Create, run, inspect, and plot the paired Figure-8 campaign on the exact
# AWS c8a.48xlarge layout. The Python collector owns worker NUMA affinity and
# the single coordinator owns all atomic ledger writes.

set -euo pipefail

readonly REPOSITORY_ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
readonly ACTIVATION_SCRIPT="$REPOSITORY_ROOT/aws/activate_environment"
readonly BENCHMARK_TOOL="$REPOSITORY_ROOT/tools/benchmark_fig8_paired_aws"
readonly PLOT_TOOL="$REPOSITORY_ROOT/tools/plot_fig8_paired"
readonly WORKER_PROCESSES=192
readonly NUMA_POOLS=2
readonly PROCESSES_PER_POOL=96


print_usage() {
    cat <<'EOF'
Usage:
  ./aws/run_fig8_paired host-check
  ./aws/run_fig8_paired create --run-id ID --p P --shots-per-cell N
  ./aws/run_fig8_paired run    --run-id ID
  ./aws/run_fig8_paired status --run-id ID
  ./aws/run_fig8_paired plot   --run-id ID

The campaign directory is always:
  $YSC_AWS_RUNS_ROOT/fig8-paired-aws192/ID

`create` requires a fresh ID. `run` is resumable and holds the machine-wide
AWS-192 collection lock. The collector uses two 96-worker pools pinned to the
two NUMA nodes; do not wrap this command in numactl. `status` and `plot` do
not acquire the collection lock.
EOF
}


die() {
    echo "error: $*" >&2
    exit 2
}


require_value() {
    local option=$1
    local remaining=$2
    (( remaining >= 2 )) || die "$option requires a value"
}


require_canonical_directory() {
    local name=$1
    local path=$2
    local physical

    [[ "$path" == /* ]] || die "$name must be an absolute path"
    [[ -d "$path" ]] || die "$name is not a directory: $path"
    [[ ! -L "$path" ]] || die "$name may not be a symbolic link: $path"
    physical="$(cd -- "$path" && pwd -P)"
    [[ "$physical" == "$path" ]] || \
        die "$name must not traverse symbolic links: $path"
}


validate_run_id() {
    local value=$1
    [[ "$value" =~ ^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$ ]] || \
        die "run ID must match [A-Za-z0-9][A-Za-z0-9_-]{0,63}"
}


validate_campaign_parent() {
    local parent=$1
    local physical

    [[ -d "$parent" ]] || die "campaign parent does not exist: $parent"
    [[ ! -L "$parent" ]] || die "campaign parent may not be a symbolic link: $parent"
    physical="$(cd -- "$parent" && pwd -P)"
    [[ "$physical" == "$parent" ]] || \
        die "campaign parent must not traverse symbolic links: $parent"
}


validate_existing_campaign() {
    local campaign=$1

    [[ ! -L "$campaign" ]] || die "campaign may not be a symbolic link: $campaign"
    [[ -d "$campaign" ]] || die "campaign does not exist: $campaign"
    [[ "$(cd -- "$campaign" && pwd -P)" == "$campaign" ]] || \
        die "campaign must not traverse symbolic links: $campaign"
}


if (( $# == 1 )) && [[ $1 == -h || $1 == --help ]]; then
    print_usage
    exit 0
fi
(( $# >= 1 )) || {
    print_usage >&2
    exit 2
}

action=$1
shift
case "$action" in
    host-check|create|run|status|plot) ;;
    *)
        print_usage >&2
        die "unknown action '$action'"
        ;;
esac

run_id=""
physical_error_rate=""
shots_per_cell=""
seen_run_id=0
seen_p=0
seen_shots=0
while (($#)); do
    case "$1" in
        --run-id)
            require_value "$1" "$#"
            (( seen_run_id == 0 )) || die "--run-id may be specified only once"
            run_id=$2
            seen_run_id=1
            shift 2
            ;;
        --p)
            require_value "$1" "$#"
            (( seen_p == 0 )) || die "--p may be specified only once"
            physical_error_rate=$2
            seen_p=1
            shift 2
            ;;
        --shots-per-cell)
            require_value "$1" "$#"
            (( seen_shots == 0 )) || \
                die "--shots-per-cell may be specified only once"
            shots_per_cell=$2
            seen_shots=1
            shift 2
            ;;
        -h|--help)
            print_usage
            exit 0
            ;;
        *)
            die "unknown argument '$1'; use --help for usage"
            ;;
    esac
done

if [[ "$action" == host-check ]]; then
    (( seen_run_id == 0 && seen_p == 0 && seen_shots == 0 )) || \
        die "host-check accepts no arguments"
else
    (( seen_run_id == 1 )) || die "$action requires --run-id"
    validate_run_id "$run_id"
    if [[ "$action" == create ]]; then
        (( seen_p == 1 )) || die "create requires --p"
        (( seen_shots == 1 )) || die "create requires --shots-per-cell"
    else
        (( seen_p == 0 && seen_shots == 0 )) || \
            die "$action accepts only --run-id"
    fi
fi

[[ -f "$ACTIVATION_SCRIPT" ]] || die "missing activation script: $ACTIVATION_SCRIPT"
# shellcheck disable=SC1090
source "$ACTIVATION_SCRIPT"

[[ -n ${YSC_AWS_RUNTIME_ROOT:-} ]] || \
    die "activation did not set YSC_AWS_RUNTIME_ROOT"
[[ -n ${YSC_AWS_RUNS_ROOT:-} ]] || \
    die "activation did not set YSC_AWS_RUNS_ROOT"
require_canonical_directory YSC_AWS_RUNTIME_ROOT "$YSC_AWS_RUNTIME_ROOT"
require_canonical_directory YSC_AWS_RUNS_ROOT "$YSC_AWS_RUNS_ROOT"

[[ ! -v MAX_ERRORS ]] || die "MAX_ERRORS must be unset for paired collection"
unset MAX_ERRORS

[[ -x "$BENCHMARK_TOOL" ]] || die "missing executable: $BENCHMARK_TOOL"

if [[ "$action" == host-check ]]; then
    "$BENCHMARK_TOOL" host-check
    exit $?
fi

campaign_parent="$YSC_AWS_RUNS_ROOT/fig8-paired-aws192"
campaign="$campaign_parent/$run_id"

if [[ "$action" == create ]]; then
    "$BENCHMARK_TOOL" host-check
    if [[ -e "$campaign_parent" || -L "$campaign_parent" ]]; then
        validate_campaign_parent "$campaign_parent"
    else
        mkdir -- "$campaign_parent"
        validate_campaign_parent "$campaign_parent"
    fi
    [[ ! -e "$campaign" && ! -L "$campaign" ]] || \
        die "create requires a fresh run ID; campaign already exists: $campaign"
    "$BENCHMARK_TOOL" create \
        --out "$campaign" \
        --p "$physical_error_rate" \
        --shots-per-cell "$shots_per_cell"
    exit $?
fi

validate_campaign_parent "$campaign_parent"
validate_existing_campaign "$campaign"

case "$action" in
    run)
        command -v flock >/dev/null 2>&1 || die "required command 'flock' was not found"

        # Recheck the exact AWS identity/topology immediately before workers
        # launch. Worker affinity is applied inside the collector, before graph
        # compilation, so Linux first-touch places each pool's memory locally.
        "$BENCHMARK_TOOL" host-check
        export OMP_NUM_THREADS=1
        export OPENBLAS_NUM_THREADS=1
        export MKL_NUM_THREADS=1
        export NUMEXPR_NUM_THREADS=1
        export VECLIB_MAXIMUM_THREADS=1
        export BLIS_NUM_THREADS=1
        export PROCESSES=$WORKER_PROCESSES
        export THREADS_PER_PROCESS=1
        export YSC_AWS_NUMA_POOLS=$NUMA_POOLS
        export YSC_AWS_PROCESSES_PER_POOL=$PROCESSES_PER_POOL
        unset MAX_ERRORS

        lock_directory="$YSC_AWS_RUNTIME_ROOT/locks"
        if [[ -e "$lock_directory" || -L "$lock_directory" ]]; then
            validate_campaign_parent "$lock_directory"
        else
            mkdir -- "$lock_directory"
            validate_campaign_parent "$lock_directory"
        fi
        lock_path="$lock_directory/collection-aws192.lock"
        [[ ! -L "$lock_path" ]] || die "collection lock may not be a symbolic link"
        exec {lock_fd}>"$lock_path"
        flock -n "$lock_fd" || \
            die "another AWS 192-worker collection is already running"

        "$BENCHMARK_TOOL" run \
            --campaign "$campaign" \
            --processes "$WORKER_PROCESSES"
        ;;
    status)
        "$BENCHMARK_TOOL" status --campaign "$campaign"
        ;;
    plot)
        [[ -x "$PLOT_TOOL" ]] || die "missing executable: $PLOT_TOOL"
        "$PLOT_TOOL" --campaign "$campaign"
        ;;
esac
