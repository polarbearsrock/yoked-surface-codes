#!/usr/bin/env bash

# Create, collect, or inspect the fixed-p paired Pinball/ProMatch Figure-8
# campaign on the existing validated AWS runtime.  Unlike run_fig8_paired,
# this workflow deliberately uses only 32 worker processes.

set -euo pipefail

readonly REPOSITORY_ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
readonly ACTIVATION_SCRIPT="$REPOSITORY_ROOT/aws/activate_environment"
readonly BENCHMARK_TOOL="$REPOSITORY_ROOT/tools/benchmark_pinball_promatch_fig8"
readonly AWS_HOST_CHECK="$REPOSITORY_ROOT/tools/benchmark_fig8_paired_aws"
readonly PLOT_TOOL="$REPOSITORY_ROOT/tools/plot_pinball_promatch_fig8"
readonly WORKER_PROCESSES=32


print_usage() {
    cat <<'EOF'
Usage:
  ./aws/run_pinball_promatch_fig8 host-check
  ./aws/run_pinball_promatch_fig8 create --run-id ID --shots-per-cell N
  ./aws/run_pinball_promatch_fig8 run    --run-id ID
  ./aws/run_pinball_promatch_fig8 status --run-id ID
  ./aws/run_pinball_promatch_fig8 plot   --run-id ID [--overwrite]

The campaign is fixed at p=0.002. Its directory is always:
  $YSC_AWS_RUNS_ROOT/pinball-promatch-fig8-aws32/ID

`create` requires a fresh ID and samples no shots. `run` is resumable and
uses exactly 32 worker processes with one native numerical thread each.
EOF
}


die() {
    echo "error: $*" >&2
    exit 2
}


require_value() {
    local option=$1
    local remaining=$2
    (( remaining >= 2 )) || die "$option requires a value"
}


require_canonical_directory() {
    local name=$1
    local path=$2
    local physical

    [[ "$path" == /* ]] || die "$name must be an absolute path"
    [[ -d "$path" ]] || die "$name is not a directory: $path"
    [[ ! -L "$path" ]] || die "$name may not be a symbolic link: $path"
    physical="$(cd -- "$path" && pwd -P)"
    [[ "$physical" == "$path" ]] || \
        die "$name must not traverse symbolic links: $path"
}


validate_run_id() {
    local value=$1
    [[ "$value" =~ ^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$ ]] || \
        die "run ID must match [A-Za-z0-9][A-Za-z0-9_-]{0,63}"
}


validate_campaign_parent() {
    local parent=$1
    local physical

    [[ -d "$parent" ]] || die "campaign parent does not exist: $parent"
    [[ ! -L "$parent" ]] || die "campaign parent may not be a symbolic link: $parent"
    physical="$(cd -- "$parent" && pwd -P)"
    [[ "$physical" == "$parent" ]] || \
        die "campaign parent must not traverse symbolic links: $parent"
}


validate_existing_campaign() {
    local campaign=$1

    [[ ! -L "$campaign" ]] || die "campaign may not be a symbolic link"
    [[ -d "$campaign" ]] || die "campaign does not exist: $campaign"
    [[ "$(cd -- "$campaign" && pwd -P)" == "$campaign" ]] || \
        die "campaign must not traverse symbolic links: $campaign"
}


if (( $# == 1 )) && [[ $1 == -h || $1 == --help ]]; then
    print_usage
    exit 0
fi
(( $# >= 1 )) || {
    print_usage >&2
    exit 2
}

action=$1
shift
case "$action" in
    host-check|create|run|status|plot) ;;
    *)
        print_usage >&2
        die "unknown action '$action'"
        ;;
esac

run_id=""
shots_per_cell=""
seen_run_id=0
seen_shots=0
overwrite=0
while (($#)); do
    case "$1" in
        --run-id)
            require_value "$1" "$#"
            (( seen_run_id == 0 )) || die "--run-id may be specified only once"
            run_id=$2
            seen_run_id=1
            shift 2
            ;;
        --shots-per-cell)
            require_value "$1" "$#"
            (( seen_shots == 0 )) || \
                die "--shots-per-cell may be specified only once"
            shots_per_cell=$2
            seen_shots=1
            shift 2
            ;;
        --overwrite)
            (( overwrite == 0 )) || die "--overwrite may be specified only once"
            overwrite=1
            shift
            ;;
        -h|--help)
            print_usage
            exit 0
            ;;
        *)
            die "unknown argument '$1'; use --help for usage"
            ;;
    esac
done

if [[ "$action" == host-check ]]; then
    (( seen_run_id == 0 && seen_shots == 0 && overwrite == 0 )) || \
        die "host-check accepts no arguments"
else
    (( seen_run_id == 1 )) || die "$action requires --run-id"
    validate_run_id "$run_id"
    if [[ "$action" == create ]]; then
        (( seen_shots == 1 )) || die "create requires --shots-per-cell"
        (( overwrite == 0 )) || die "create does not accept --overwrite"
    else
        (( seen_shots == 0 )) || die "$action accepts only --run-id"
        if [[ "$action" != plot ]]; then
            (( overwrite == 0 )) || die "$action does not accept --overwrite"
        fi
    fi
fi

[[ -f "$ACTIVATION_SCRIPT" ]] || die "missing activation script: $ACTIVATION_SCRIPT"
# shellcheck disable=SC1090
source "$ACTIVATION_SCRIPT"

# The shared activation file describes the separately authorized 192-worker
# campaign. Override those values before this campaign imports any numerical
# work or launches a child process.
export PROCESSES=$WORKER_PROCESSES
export THREADS_PER_PROCESS=1
unset YSC_AWS_NUMA_POOLS
unset YSC_AWS_PROCESSES_PER_POOL
unset MAX_ERRORS

[[ -n ${YSC_AWS_RUNTIME_ROOT:-} ]] || \
    die "activation did not set YSC_AWS_RUNTIME_ROOT"
[[ -n ${YSC_AWS_RUNS_ROOT:-} ]] || \
    die "activation did not set YSC_AWS_RUNS_ROOT"
require_canonical_directory YSC_AWS_RUNTIME_ROOT "$YSC_AWS_RUNTIME_ROOT"
require_canonical_directory YSC_AWS_RUNS_ROOT "$YSC_AWS_RUNS_ROOT"
[[ -x "$BENCHMARK_TOOL" ]] || die "missing executable: $BENCHMARK_TOOL"
[[ -x "$AWS_HOST_CHECK" ]] || die "missing executable: $AWS_HOST_CHECK"

if [[ "$action" == host-check ]]; then
    "$AWS_HOST_CHECK" host-check
    exit $?
fi

campaign_parent="$YSC_AWS_RUNS_ROOT/pinball-promatch-fig8-aws32"
campaign="$campaign_parent/$run_id"

if [[ "$action" == create ]]; then
    "$AWS_HOST_CHECK" host-check
    if [[ -e "$campaign_parent" || -L "$campaign_parent" ]]; then
        validate_campaign_parent "$campaign_parent"
    else
        mkdir -- "$campaign_parent"
        validate_campaign_parent "$campaign_parent"
    fi
    [[ ! -e "$campaign" && ! -L "$campaign" ]] || \
        die "create requires a fresh run ID; campaign already exists: $campaign"
    "$BENCHMARK_TOOL" create \
        --out "$campaign" \
        --shots-per-cell "$shots_per_cell"
    exit $?
fi

validate_campaign_parent "$campaign_parent"
validate_existing_campaign "$campaign"

case "$action" in
    run)
        command -v flock >/dev/null 2>&1 || die "required command 'flock' was not found"
        "$AWS_HOST_CHECK" host-check
        export OMP_NUM_THREADS=1
        export OPENBLAS_NUM_THREADS=1
        export MKL_NUM_THREADS=1
        export NUMEXPR_NUM_THREADS=1
        export VECLIB_MAXIMUM_THREADS=1
        export BLIS_NUM_THREADS=1
        export PROCESSES=$WORKER_PROCESSES
        export THREADS_PER_PROCESS=1
        unset MAX_ERRORS

        lock_directory="$YSC_AWS_RUNTIME_ROOT/locks"
        if [[ -e "$lock_directory" || -L "$lock_directory" ]]; then
            validate_campaign_parent "$lock_directory"
        else
            mkdir -- "$lock_directory"
            validate_campaign_parent "$lock_directory"
        fi

        # Holding the legacy lock also prevents the 192-worker campaign from
        # starting while this 32-worker campaign is active, and vice versa.
        legacy_lock="$lock_directory/collection-aws192.lock"
        campaign_lock="$lock_directory/collection-pinball-promatch-aws32.lock"
        [[ ! -L "$legacy_lock" && ! -L "$campaign_lock" ]] || \
            die "collection lock may not be a symbolic link"
        exec {legacy_lock_fd}>"$legacy_lock"
        flock -n "$legacy_lock_fd" || \
            die "another AWS simulation collection is already running"
        exec {campaign_lock_fd}>"$campaign_lock"
        flock -n "$campaign_lock_fd" || \
            die "another Pinball/ProMatch collection is already running"

        "$BENCHMARK_TOOL" run \
            --campaign "$campaign" \
            --processes "$WORKER_PROCESSES"
        ;;
    status)
        "$BENCHMARK_TOOL" status --campaign "$campaign"
        ;;
    plot)
        [[ -x "$PLOT_TOOL" ]] || die "missing executable: $PLOT_TOOL"
        plot_args=(--campaign "$campaign")
        if (( overwrite == 1 )); then
            plot_args+=(--overwrite)
        fi
        "$PLOT_TOOL" "${plot_args[@]}"
        ;;
esac
