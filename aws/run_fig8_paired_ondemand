#!/usr/bin/env bash

# Audited continuation of an existing AWS Spot Figure-8 campaign on an exact
# On-Demand c8a.48xlarge.  This wrapper never creates or rewrites a campaign;
# it freezes a sibling continuation record and reuses the original schedule.

set -euo pipefail

readonly REPOSITORY_ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
readonly ACTIVATION_SCRIPT="$REPOSITORY_ROOT/aws/activate_environment"
readonly BENCHMARK_TOOL="$REPOSITORY_ROOT/tools/benchmark_fig8_paired_aws_ondemand"
readonly WORKER_PROCESSES=192
readonly NUMA_POOLS=2
readonly PROCESSES_PER_POOL=96


print_usage() {
    cat <<'EOF'
Usage:
  ./aws/run_fig8_paired_ondemand prepare --run-id ID
  ./aws/run_fig8_paired_ondemand run     --run-id ID
  ./aws/run_fig8_paired_ondemand status  --run-id ID

`prepare` is a no-sampling operation that freezes the exact existing Spot
ledgers and the On-Demand execution host in a separate sibling record. `run`
then schedules only missing batches from the original immutable campaign.
EOF
}


die() {
    echo "error: $*" >&2
    exit 2
}


require_canonical_directory() {
    local name=$1
    local path=$2
    local physical

    [[ "$path" == /* ]] || die "$name must be an absolute path"
    [[ -d "$path" ]] || die "$name is not a directory: $path"
    [[ ! -L "$path" ]] || die "$name may not be a symbolic link: $path"
    physical="$(cd -- "$path" && pwd -P)"
    [[ "$physical" == "$path" ]] || \
        die "$name must not traverse symbolic links: $path"
}


validate_run_id() {
    local value=$1
    [[ "$value" =~ ^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$ ]] || \
        die "run ID must match [A-Za-z0-9][A-Za-z0-9_-]{0,63}"
}


if (( $# == 1 )) && [[ $1 == -h || $1 == --help ]]; then
    print_usage
    exit 0
fi
(( $# == 3 )) || {
    print_usage >&2
    exit 2
}

action=$1
shift
case "$action" in
    prepare|run|status) ;;
    *) die "unknown action '$action'" ;;
esac
[[ $1 == --run-id ]] || die "$action requires --run-id ID"
run_id=$2
validate_run_id "$run_id"

[[ -f "$ACTIVATION_SCRIPT" ]] || die "missing activation script: $ACTIVATION_SCRIPT"
# shellcheck disable=SC1090
source "$ACTIVATION_SCRIPT"

[[ -n ${YSC_AWS_RUNTIME_ROOT:-} ]] || \
    die "activation did not set YSC_AWS_RUNTIME_ROOT"
[[ -n ${YSC_AWS_RUNS_ROOT:-} ]] || \
    die "activation did not set YSC_AWS_RUNS_ROOT"
require_canonical_directory YSC_AWS_RUNTIME_ROOT "$YSC_AWS_RUNTIME_ROOT"
require_canonical_directory YSC_AWS_RUNS_ROOT "$YSC_AWS_RUNS_ROOT"

[[ ! -v MAX_ERRORS ]] || die "MAX_ERRORS must be unset for paired collection"
unset MAX_ERRORS

[[ -x "$BENCHMARK_TOOL" ]] || die "missing executable: $BENCHMARK_TOOL"

campaign_parent="$YSC_AWS_RUNS_ROOT/fig8-paired-aws192"
campaign="$campaign_parent/$run_id"
require_canonical_directory CAMPAIGN_PARENT "$campaign_parent"
require_canonical_directory CAMPAIGN "$campaign"

if [[ "$action" == status ]]; then
    "$BENCHMARK_TOOL" status --campaign "$campaign"
    exit $?
fi

command -v flock >/dev/null 2>&1 || die "required command 'flock' was not found"
export OMP_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export MKL_NUM_THREADS=1
export NUMEXPR_NUM_THREADS=1
export VECLIB_MAXIMUM_THREADS=1
export BLIS_NUM_THREADS=1
export PROCESSES=$WORKER_PROCESSES
export THREADS_PER_PROCESS=1
export YSC_AWS_NUMA_POOLS=$NUMA_POOLS
export YSC_AWS_PROCESSES_PER_POOL=$PROCESSES_PER_POOL
unset MAX_ERRORS

lock_directory="$YSC_AWS_RUNTIME_ROOT/locks"
if [[ -e "$lock_directory" || -L "$lock_directory" ]]; then
    require_canonical_directory LOCK_DIRECTORY "$lock_directory"
else
    mkdir -- "$lock_directory"
    require_canonical_directory LOCK_DIRECTORY "$lock_directory"
fi
lock_path="$lock_directory/collection-aws192.lock"
[[ ! -L "$lock_path" ]] || die "collection lock may not be a symbolic link"
exec {lock_fd}>"$lock_path"
flock -n "$lock_fd" || die "another AWS 192-worker collection is already running"

case "$action" in
    prepare)
        "$BENCHMARK_TOOL" prepare --campaign "$campaign"
        ;;
    run)
        "$BENCHMARK_TOOL" run \
            --campaign "$campaign" \
            --processes "$WORKER_PROCESSES"
        ;;
esac
