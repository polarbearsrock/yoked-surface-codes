#!/usr/bin/env python3

import argparse
import itertools
import math
import pathlib

import sys

_REPO_ROOT = pathlib.Path(__file__).resolve().parent.parent
sys.path.insert(0, str(_REPO_ROOT / 'src'))

import gen
from yoked._yoked_memory_circuits import yoked_magic_memory_circuit
from yoked._squareberg_circuits import squareberg_magic_memory_circuit


def main():
    parser = argparse.ArgumentParser(
        description='Generates noisy yoked-memory stim circuits, one file per '
                    'parameter combination, named by their metadata.')
    parser.add_argument('--patch_diameter', nargs='+', type=int, required=True,
                        help='Patch diameters (d) to generate circuits for.')
    parser.add_argument('--rounds', nargs='+', type=str, required=True,
                        help="Python expressions eval'd with variables d and yokes, "
                             "giving the number of rounds (e.g. '10*d').")
    parser.add_argument('--noise_strength', nargs='+', type=float, required=True,
                        help='Noise strengths (p) to generate circuits for.')
    parser.add_argument('--filter_func', type=str, default='True',
                        help="Python expression eval'd with keyword arguments rounds, "
                             'patch_diameter, noise_strength, patches, yokes, and '
                             'gateset; parameter combinations where it is falsy '
                             'are skipped.')
    parser.add_argument('--patches', nargs='+', type=str, required=True,
                        help="Python expressions eval'd with variable yokes, giving "
                             "the number of patches (e.g. '4 + yokes').")
    parser.add_argument('--yokes', nargs='+', type=int, required=True,
                        help='Numbers of yokes: 0-2 for linear yoking, or 4*sqrt(patches) '
                             'for a squareberg layout.')
    parser.add_argument('--gateset', choices=['cz', 'css'], default=['cz'], nargs='+',
                        help='Gatesets to use: cz applies SI1000 noise, css applies '
                             'uniform depolarizing noise.')
    parser.add_argument('--extra', type=str, default="{}",
                        help="Python dict expression eval'd to extra metadata entries "
                             'merged into each circuit filename.')
    parser.add_argument('--out_dir', type=str, default='out/circuits',
                        help='Directory the .stim circuit files are written into.')
    parser.add_argument('--debug', action='store_true',
                        help='Also write debug_noisy.html, debug_ideal.html, and '
                             'debug_detslice.svg viewers for the last circuit.')
    parser.add_argument('--remove_x_yoke', action='store_true', default=False,
                        help='Only yoke the Z observables (drop the X yoke).')
    args = parser.parse_args()
    out_dir = pathlib.Path(args.out_dir)
    out_dir.mkdir(parents=True, exist_ok=True)

    args.filter_func = eval(compile(
        f'lambda *, rounds, patch_diameter, noise_strength, patches, yokes, gateset: {args.filter_func}',
        filename='filter_func:command_line_arg',
        mode='eval'))

    for (
        patch_diameter,
        rounds_func,
        noise_strength,
        patches_func,
        yokes,
        gateset,
    ) in itertools.product(
        args.patch_diameter,
        args.rounds,
        args.noise_strength,
        args.patches,
        args.yokes,
        args.gateset,
    ):
        patches = eval(patches_func, {'yokes': yokes})
        rounds = eval(rounds_func, {'yokes': yokes, 'd': patch_diameter})
        extras = eval(args.extra, {})
        if not args.filter_func(
            patch_diameter=patch_diameter,
            rounds=rounds,
            noise_strength=noise_strength,
            patches=patches,
            yokes=yokes,
            gateset=gateset,
        ):
            continue
        if gateset == 'cz':
            noise = 'si1000'
            noise_model = gen.NoiseModel.si1000(noise_strength)
        else:
            noise = 'uniform'
            noise_model = gen.NoiseModel.uniform_depolarizing(noise_strength)
        if yokes > 2:
            w = round(math.sqrt(patches) / 4) * 4
            if w * w != patches or yokes != w * 4:
                raise ValueError(f'{w * w=} != {patches=} or {yokes=} != {w*4=}')
            circuit = squareberg_magic_memory_circuit(
                patch_diameter=patch_diameter,
                rounds=rounds,
                noise=noise_model,
                style=gateset,
                num_patches=patches,
            )
        else:
            circuit = yoked_magic_memory_circuit(
                patch_diameter=patch_diameter,
                rounds=rounds,
                noise=noise_model,
                style=gateset,
                yokes=yokes,
                num_patches=patches,
                remove_x_yoke=args.remove_x_yoke,
            )
        metadata = {
            'd': patch_diameter,
            'r': rounds,
            'p': noise_strength,
            'patches': patches,
            'yokes': int(yokes),
            'noise': noise,
            'b': 'magic',
            'c': 'memory',
            'gateset': gateset,
            'q': circuit.num_qubits,
            **extras,
        }
        meta_str = ','.join(f'{k}={v}' for k, v in metadata.items())
        circuit_path = out_dir / f'{meta_str}.stim'
        circuit.to_file(circuit_path)
        print(f'wrote {circuit_path}')
        if args.debug:
            gen.write_file(out_dir / "debug_noisy.html", gen.stim_circuit_html_viewer(circuit))
            gen.write_file(out_dir / "debug_ideal.html", gen.stim_circuit_html_viewer(circuit.without_noise()))
            gen.write_file(out_dir / "debug_detslice.svg", circuit.without_noise().diagram("time+detector-slice-svg"))


if __name__ == '__main__':
    main()
