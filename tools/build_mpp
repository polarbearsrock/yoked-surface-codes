#!/usr/bin/env python3
"""Build the optional MPP extension from pinned local sources; no downloads.

Run with the repository's Python environment. Keep --out and source checkouts
under $TMPDIR. See docs/mpp_confidence_experiment.md for the complete recipe.
"""
import argparse
import hashlib
import json
import os
from pathlib import Path
import subprocess
import sys
import sysconfig

ROOT = Path(__file__).resolve().parent.parent
PINS = {
    'pymatching': '6f63b2b9474ba0fa7e511fe52bffdce858a06984',  # v2.4.0
    'stim': '1320ad7eac7de34d2e9c70daa44fbc6d84174450',
    'pybind11': 'a2e59f0e7065404b44dfe92a28aca47ba1378dc4',
}
SOURCES = ('native/mpp/mpp_fast.cc', 'native/mpp/CMakeLists.txt', 'tools/build_mpp')


def digest(path):
    return hashlib.sha256(Path(path).read_bytes()).hexdigest()


def checked_checkout(path, name):
    """Do not silently compile a different engine or locally edited dependency."""
    revision = subprocess.check_output(['git', '-C', str(path), 'rev-parse', 'HEAD'], text=True).strip()
    changed = subprocess.check_output(['git', '-C', str(path), 'status', '--porcelain',
                                       '--untracked-files=all'], text=True).strip()
    if revision != PINS[name] or changed:
        raise ValueError(f'{name} must be a clean checkout of {PINS[name]}: {path}')
    return revision


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--pymatching-source', type=Path, required=True)
    parser.add_argument('--stim-source', type=Path, required=True)
    parser.add_argument('--out', type=Path, required=True)
    parser.add_argument('--cxx', help='C++20 compiler; use a fresh --out when changing compiler')
    parser.add_argument('--cc', help='C compiler for the Stim subproject')
    parser.add_argument('--jobs', type=int, default=4)
    args = parser.parse_args()
    if args.jobs < 1:
        parser.error('--jobs must be positive')
    out = args.out.resolve()
    temporary_root = Path(os.environ['TMPDIR']).resolve()
    os.environ.setdefault('CCACHE_DIR', str(temporary_root / 'dante/cache/ccache'))
    if not out.is_relative_to(temporary_root):
        parser.error('--out must be under $TMPDIR')
    matching, stim = args.pymatching_source.resolve(), args.stim_source.resolve()
    dependencies = {name: checked_checkout(path, name) for name, path in (
        ('pymatching', matching), ('stim', stim), ('pybind11', matching / 'pybind11'))}
    out.mkdir(parents=True, exist_ok=True)
    # A failed rebuild must not leave a manifest certifying the previous binary.
    manifest = out / 'build.json'
    manifest.unlink(missing_ok=True)
    configure = ['cmake', '-S', str(ROOT / 'native/mpp'), '-B', str(out), '-G', 'Ninja',
                 '-DCMAKE_BUILD_TYPE=Release', f'-DPython_EXECUTABLE={sys.executable}',
                 f'-DPYMATCHING_SOURCE={matching}', f'-DSTIM_SOURCE={stim}']
    if args.cxx:
        configure.append(f'-DCMAKE_CXX_COMPILER={args.cxx}')
    if args.cc:
        configure.append(f'-DCMAKE_C_COMPILER={args.cc}')
    build = ['cmake', '--build', str(out), '--target', '_mpp_fast', '-j', str(args.jobs)]
    subprocess.run(configure, check=True)
    subprocess.run(build, check=True)
    module = out / ('_mpp_fast' + sysconfig.get_config_var('EXT_SUFFIX'))
    cache = (out / 'CMakeCache.txt').read_text()
    compiler = next(line.split('=', 1)[1] for line in cache.splitlines()
                    if line.startswith('CMAKE_CXX_COMPILER:'))
    metadata = {
        'schema': 'mpp-native-build/1', 'dependencies': dependencies,
        'source_sha256': {path: digest(ROOT / path) for path in SOURCES},
        'module': module.name, 'module_sha256': digest(module),
        'python': sys.version, 'python_executable': sys.executable,
        'compiler': subprocess.check_output([compiler, '--version'], text=True).splitlines()[0],
        'commands': [configure, build],
    }
    manifest.write_text(json.dumps(metadata, indent=2) + '\n')
    print(f'MPP extension ready. Set YOKED_MPP_BUILD={out}')


if __name__ == '__main__':
    main()
