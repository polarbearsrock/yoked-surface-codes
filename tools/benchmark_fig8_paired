#!/usr/bin/env python3
"""Create, run, or inspect a frozen paired Figure-8b sweep."""

from __future__ import annotations

# Pin native libraries before importing NumPy/PyMatching through the harness.
# ruff: noqa: E402
import os

for _name in (
    "OMP_NUM_THREADS",
    "OPENBLAS_NUM_THREADS",
    "MKL_NUM_THREADS",
    "NUMEXPR_NUM_THREADS",
    "VECLIB_MAXIMUM_THREADS",
    "BLIS_NUM_THREADS",
):
    os.environ[_name] = "1"

import argparse
import json
from pathlib import Path
import sys

_REPO_ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(_REPO_ROOT / "src"))

from yoked.decoding._fig8_paired_sweep import (  # noqa: E402
    REQUIRED_PROCESSES,
    campaign_status,
    create_campaign,
    run_campaign,
)


def _parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        description="Frozen paired U0-versus-PU Figure-8b sweep"
    )
    commands = parser.add_subparsers(dest="command", required=True)

    create = commands.add_parser("create", help="freeze a new 16-cell campaign")
    create.add_argument("--out", type=Path, required=True)
    create.add_argument(
        "--p",
        type=float,
        required=True,
        help=(
            "SI1000 physical error probability (model domain 0 < p <= 0.2; "
            "create also rejects graph-incompatible weights)"
        ),
    )
    create.add_argument("--shots-per-cell", type=int, required=True)

    run = commands.add_parser("run", help="collect or resume frozen paired batches")
    run.add_argument("--campaign", type=Path, required=True)
    run.add_argument("--processes", type=int, required=True)

    status = commands.add_parser("status", help="validate and report campaign progress")
    status.add_argument("--campaign", type=Path, required=True)
    return parser


def _compact(value: object) -> str:
    return json.dumps(value, sort_keys=True, separators=(",", ":"), allow_nan=False)


def main(argv: list[str] | None = None) -> int:
    args = _parser().parse_args(argv)
    try:
        if args.command == "create":
            campaign = create_campaign(
                args.out,
                p=args.p,
                shots_per_cell=args.shots_per_cell,
            )
            print(
                _compact(
                    {
                        "campaign": str(args.out.absolute()),
                        "experiment_id": campaign["experiment_id"],
                        "cells": len(campaign["cells"]),
                        "shots_per_cell": campaign["shots_per_cell"],
                    }
                )
            )
            return 0
        if args.command == "run":
            if args.processes != REQUIRED_PROCESSES:
                raise ValueError(
                    f"Figure-8 campaign requires exactly {REQUIRED_PROCESSES} processes"
                )
            print(_compact(run_campaign(args.campaign, processes=args.processes)))
            return 0
        print(_compact(campaign_status(args.campaign)))
        return 0
    except (ValueError, TypeError, RuntimeError, OSError) as ex:
        print(f"error: {ex}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
