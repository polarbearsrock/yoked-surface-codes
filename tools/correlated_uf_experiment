#!/usr/bin/env python3
"""Run correlated UF + full cluster gaps -> plain MWPM on saved sample rows."""
import argparse
from pathlib import Path
import sys

import numpy as np

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / 'src'))
from yoked.hierarchical._collect import SampleSet
from yoked.hierarchical._correlated_uf_experiment import stage_correlated_uf


def row_range(text):
    try:
        start, stop = map(int, text.split(':'))
        if not 0 <= start < stop:
            raise ValueError()
    except ValueError:
        raise argparse.ArgumentTypeError('rows must be a nonempty START:STOP range') from None
    return np.arange(start, stop)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--sample', type=Path, help='verified SampleSet directory')
    parser.add_argument('--baseline-run', type=Path,
                        help='completed MWPM comparison distance; uses its sample/ by default')
    parser.add_argument('--out', type=Path, required=True, help='new output directory')
    parser.add_argument('--rows', type=row_range)
    parser.add_argument('--batch-size', type=int, default=64)
    parser.add_argument('--bootstrap-replicates', type=int, default=10000)
    parser.add_argument('--bootstrap-seed', type=int, default=43)
    args = parser.parse_args()
    if args.sample is None and args.baseline_run is None:
        parser.error('provide --sample or --baseline-run')
    path = args.sample if args.sample is not None else args.baseline_run / 'sample'
    result = stage_correlated_uf(
        SampleSet.load(path), args.out, baseline_run=args.baseline_run, rows=args.rows,
        batch_size=args.batch_size, replicates=args.bootstrap_replicates, seed=args.bootstrap_seed,
        progress=lambda done, total: print(f'{done}/{total} shots decoded', flush=True))
    for name, row in result['configurations'].items():
        print(f"{name}: {row['block_failures']}/{result['shots']} block failures")
    print(f'Artifacts: {args.out}')


if __name__ == '__main__':
    main()
