#!/usr/bin/env python3
"""Prepare, probe, collect, and verify the B1 policy-audit corpus."""

from __future__ import annotations

import os

for _name in (
    "OMP_NUM_THREADS",
    "OPENBLAS_NUM_THREADS",
    "MKL_NUM_THREADS",
    "NUMEXPR_NUM_THREADS",
    "VECLIB_MAXIMUM_THREADS",
    "BLIS_NUM_THREADS",
):
    os.environ[_name] = "1"

import argparse
import json
from pathlib import Path
import sys

_ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(_ROOT / "src"))

from yoked.decoding._promatch_policy_casebook import (  # noqa: E402
    expand_authenticated_policy_casebook,
    finalize_policy_audit,
    verify_policy_casebook_expansion,
)
from yoked.decoding._promatch_policy_experiment import (  # noqa: E402
    freeze_policy_protocol,
    inspect_policy_protocol,
    materialize_policy_draft,
    policy_worker_schedule,
    run_policy_collection,
    validate_policy_protocol,
    verify_worker_shard,
)


def _unique_object(pairs):
    result = {}
    for key, value in pairs:
        if key in result:
            raise ValueError(f"duplicate JSON object key {key!r}")
        result[key] = value
    return result


def _load(path: Path):
    with path.open(encoding="utf-8") as f:
        value = json.load(f, object_pairs_hook=_unique_object)
    if not isinstance(value, dict):
        raise ValueError(f"{path} must contain one JSON object")
    return value


def _write_new(path: Path, value) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("x", encoding="utf-8") as f:
        json.dump(value, f, sort_keys=True, indent=2, allow_nan=False)
        f.write("\n")


def _parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        description="Fixed 32-worker B1 human-interpretable policy audit"
    )
    commands = parser.add_subparsers(dest="command", required=True)

    inspect = commands.add_parser("inspect", help="inspect draft graph provenance")
    inspect.add_argument("--protocol", type=Path, required=True)

    freeze = commands.add_parser(
        "freeze", help="freeze a clean implementation commit into a new config"
    )
    freeze.add_argument("--protocol", type=Path, required=True)
    freeze.add_argument("--out-protocol", type=Path, required=True)
    freeze.add_argument(
        "--probe-root",
        type=Path,
        required=True,
        help="completed exact 100-shot probe root with ANALYSIS_READY",
    )

    for name, help_text in (
        ("smoke", "run the disjoint 32-shot scratch integration smoke"),
        ("probe", "run the disjoint 100-shot timing/storage probe"),
        ("collect", "run or verify the frozen 20,000-shot scientific corpus"),
    ):
        command = commands.add_parser(name, help=help_text)
        command.add_argument("--protocol", type=Path, required=True)
        command.add_argument("--out", type=Path, required=True)
        command.add_argument("--processes", type=int, default=32)

    verify = commands.add_parser("verify", help="verify every immutable worker shard")
    verify.add_argument("--protocol", type=Path, required=True)
    verify.add_argument("--out", type=Path, required=True)
    verify.add_argument(
        "--mode", choices=("scientific", "smoke", "probe"), required=True
    )

    expand = commands.add_parser(
        "expand-casebook",
        help="authenticate and replay the installed post-selection casebook",
    )
    expand.add_argument("--protocol", type=Path, required=True)
    expand.add_argument("--collection", type=Path, required=True)

    verify_casebook = commands.add_parser(
        "verify-casebook",
        help="recompute and authenticate an installed exhaustive casebook",
    )
    verify_casebook.add_argument("--protocol", type=Path, required=True)
    verify_casebook.add_argument("--collection", type=Path, required=True)

    finalize = commands.add_parser(
        "finalize",
        help="verify every evidence layer and write COMPLETE last",
    )
    finalize.add_argument("--protocol", type=Path, required=True)
    finalize.add_argument("--collection", type=Path, required=True)
    return parser


def main() -> int:
    args = _parser().parse_args()
    try:
        config = _load(args.protocol)
        if args.command == "inspect":
            print(json.dumps(inspect_policy_protocol(config), indent=2, sort_keys=True))
            return 0
        if args.command == "freeze":
            try:
                relative = args.out_protocol.resolve().relative_to(_ROOT.resolve()).as_posix()
            except ValueError as ex:
                raise ValueError("frozen protocol output must be inside the repository") from ex
            frozen = freeze_policy_protocol(
                config,
                protocol_relative_path=relative,
                probe_root=args.probe_root,
                root=_ROOT,
            )
            _write_new(args.out_protocol, frozen)
            print(f"wrote frozen B1 protocol {args.out_protocol}")
            print(f"experiment_id={frozen['experiment_id']}")
            return 0
        if args.command in {"smoke", "probe", "collect"}:
            scientific = args.command == "collect"
            mode = "scientific" if scientific else args.command
            manifest = run_policy_collection(
                config,
                mode=mode,
                out=args.out,
                processes=args.processes,
                scientific=scientific,
                protocol_path=args.protocol if scientific else None,
            )
            print(json.dumps(manifest, indent=2, sort_keys=True))
            return 0
        if args.command == "verify":
            runtime_config = config
            if args.mode != "scientific":
                stored_config = _load(args.out / "config.json")
                expected_config = (
                    materialize_policy_draft(config)
                    if "circuit_sha256" not in config.get("cell", {})
                    else config
                )
                if stored_config != expected_config:
                    raise ValueError(
                        "scratch collection config is not the materialized supplied draft"
                    )
                runtime_config = stored_config
            validate_policy_protocol(
                runtime_config,
                scientific=args.mode == "scientific",
                protocol_path=args.protocol if args.mode == "scientific" else None,
            )
            verified = []
            for spec in policy_worker_schedule(args.mode):
                path = args.out / "shards" / f"worker-{spec.worker_id:02d}"
                verify_worker_shard(
                    path, config=runtime_config, mode=args.mode, spec=spec
                )
                verified.append(spec.worker_id)
            print(json.dumps({"verified_worker_ids": verified}, indent=2))
            return 0
        if args.command == "expand-casebook":
            result = expand_authenticated_policy_casebook(
                config=config,
                root=args.collection,
                protocol_path=args.protocol,
            )
            print(json.dumps(result, indent=2, sort_keys=True))
            return 0
        if args.command == "verify-casebook":
            result = verify_policy_casebook_expansion(
                config=config,
                root=args.collection,
                protocol_path=args.protocol,
            )
            print(json.dumps(result, indent=2, sort_keys=True))
            return 0
        if args.command == "finalize":
            result = finalize_policy_audit(
                config=config,
                root=args.collection,
                protocol_path=args.protocol,
            )
            print(json.dumps(result, indent=2, sort_keys=True))
            return 0
        raise AssertionError("unreachable command")
    except (ValueError, TypeError, RuntimeError, OSError, NotImplementedError) as ex:
        print(f"error: {ex}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
