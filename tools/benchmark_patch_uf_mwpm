def _pid_is_alive(pid: int) -> bool:
    if isinstance(pid, bool) or not isinstance(pid, int) or pid <= 0:
        raise ValueError("campaign lock owner PID is malformed")
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    return True


@dataclasses.dataclass(frozen=True)
class _CampaignLockLease:
    path: Path
    device: int
    inode: int

    def release(self) -> None:
        try:
            current = self.path.lstat()
        except FileNotFoundError as ex:
            raise RuntimeError("campaign lock disappeared before cleanup") from ex
        if (current.st_dev, current.st_ino) != (self.device, self.inode):
            raise RuntimeError("campaign lock identity changed before cleanup")
        self.path.unlink()


def _acquire_campaign_lock(
    tmp_root: Path, *, command: str, target: Path
) -> _CampaignLockLease:
    path = tmp_root / "patch-uf-mwpm-campaign-v1.lock"
    record = {
        "schema": CAMPAIGN_LOCK_SCHEMA,
        "pid": os.getpid(),
        "command": command,
        "target": str(target.absolute()),
        "policy": CAMPAIGN_LOCK_POLICY,
    }
    payload = canonical_json_bytes(record) + b"\n"
    stale_retry = False
    while True:
        try:
            descriptor = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        except FileExistsError as ex:
            if path.is_symlink() or not path.is_file():
                raise RuntimeError("campaign lock is not a regular file") from ex
            stat_before = path.lstat()
            existing = load_json_strict(path, description="Patch-UF campaign lock")
            if existing.get("schema") != CAMPAIGN_LOCK_SCHEMA:
                raise RuntimeError("campaign lock schema is malformed") from ex
            owner = existing.get("pid")
            if _pid_is_alive(owner):
                raise RuntimeError(
                    f"Patch-UF campaign already active under PID {owner}"
                ) from ex
            if stale_retry:
                raise RuntimeError("campaign lock stale-owner recovery raced") from ex
            try:
                stat_after = path.lstat()
            except FileNotFoundError:
                stale_retry = True
                continue
            if (stat_before.st_dev, stat_before.st_ino) != (
                stat_after.st_dev,
                stat_after.st_ino,
            ):
                stale_retry = True
                continue
            path.unlink()
            stale_retry = True
            continue
        try:
            with os.fdopen(descriptor, "wb") as destination:
                destination.write(payload)
                destination.flush()
                os.fsync(destination.fileno())
            acquired = path.lstat()
            return _CampaignLockLease(path, acquired.st_dev, acquired.st_ino)
        except BaseException:
            try:
                path.unlink()
            except FileNotFoundError:
                pass
            raise


def _reject_max_errors() -> None:
