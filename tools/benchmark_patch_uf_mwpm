def _parse_latency_protocol(protocol: Mapping[str, Any]) -> LatencyProtocol:
    value = protocol.get("latency")
    if not isinstance(value, Mapping):
        raise ValueError("latency must be an object")
    batches = value.get("batches")
    if not isinstance(batches, list) or not batches:
        raise ValueError("latency.batches must be a nonempty array")
    parsed_batches: list[BatchTiming] = []
    expected_batch_fields = set(EXPECTED_LATENCY_BATCHES[0])
    for index, raw in enumerate(batches):
        if not isinstance(raw, Mapping) or set(raw) != expected_batch_fields:
            raise ValueError(f"latency.batches[{index}] fields are malformed")
        parsed_batches.append(BatchTiming(**dict(raw)))
    seed = value.get("schedule_seed")
    if not is_lowercase_hex(seed, length=64):
        raise ValueError("latency.schedule_seed must be 64 lowercase hex characters")
    host = value.get("host_policy")
    if not isinstance(host, Mapping):
        raise ValueError("latency.host_policy must be an object")
    expected_host = host.get("expected_host")
    if not isinstance(expected_host, Mapping):
        raise ValueError("latency.host_policy.expected_host must be an object")
    affinity = host.get("cpu_affinity")
    nodes = host.get("expected_numa_nodes")
    if not isinstance(affinity, list) or not isinstance(nodes, list):
        raise ValueError("latency host affinity and NUMA nodes must be arrays")
    return LatencyProtocol(
        batches=tuple(parsed_batches),
        schedule_seed=int(seed, 16),
        host_policy=HostPolicy(
            cpu_affinity=tuple(affinity),
            expected_host=tuple(sorted(expected_host.items())),
            expected_numa_nodes=tuple(nodes),
        ),
    )


def _validate_source_path_list(value: Any) -> tuple[str, ...]:
    if not isinstance(value, list) or not value:
        raise ValueError("source_paths must be a nonempty array")
    if any(not isinstance(item, str) or not item for item in value):
        raise ValueError("source_paths entries must be nonempty strings")
    result = tuple(value)
    if result != tuple(sorted(set(result))):
        raise ValueError("source_paths must be sorted and unique")
    missing = sorted(MINIMUM_SOURCE_PATHS - set(result))
    if missing:
        raise ValueError(f"source_paths omits required implementation files: {missing}")
    for relative in result:
        candidate = Path(relative)
        if candidate.is_absolute() or ".." in candidate.parts or candidate == Path("."):
            raise ValueError(f"invalid source path {relative!r}")
    return result


def _validate_protocol_contract(
    protocol: Mapping[str, Any], *, expected_status: str
) -> LatencyProtocol:
    if not isinstance(protocol, Mapping):
        raise TypeError("protocol must be an object")
    value = dict(protocol)
    required = set(_protocol_contract()["required_top_level"])
    missing = sorted(required - set(value))
    if missing:
        raise ValueError(f"protocol is missing required fields: {missing}")
    if value.get("schema") != PROTOCOL_SCHEMA or value.get("schema_version") != 1:
        raise ValueError("protocol schema/version mismatch")
    if value.get("status") != expected_status:
        raise ValueError(f"protocol status must be {expected_status!r}")
    if value.get("frozen") is not (expected_status == "FROZEN"):
        raise ValueError("protocol frozen flag disagrees with status")
    if value.get("claim_status") != "non-claim-bearing":
        raise ValueError("claim_status must be 'non-claim-bearing'")
    _reject_tbd(value)

    cell = value.get("selected_cell")
    if not isinstance(cell, Mapping):
        raise ValueError("selected_cell must be an object")
    expected_cell = {
        "cell_id": "cguf-01-d7-n6-y2-r28-p0.003",
        "d": 7,
        "r": 28,
        "p": 0.003,
        "patches": 6,
        "yokes": 2,
        "style": "cz",
        "noise": "si1000",
        "remove_x_yoke": False,
    }
    for key, expected in expected_cell.items():
        if cell.get(key) != expected:
            raise ValueError(f"selected_cell.{key} must be {expected!r}")
    if not isinstance(cell.get("p"), float) or cell["p"].hex() != (0.003).hex():
        raise ValueError("selected_cell.p must be exact binary64 0.003")
    permitted_cell = set(expected_cell) | {"provenance"}
    if set(cell) - permitted_cell:
        raise ValueError(
            f"selected_cell has unknown fields: {sorted(set(cell) - permitted_cell)}"
        )

    if dict(value.get("dem_options", {})) != {
        "decompose_errors": True,
        "approximate_disjoint_errors": True,
    }:
        raise ValueError("dem_options differs from the frozen V1 contract")
    decoder = value.get("decoder")
    expected_decoder = {
        "arms": EXPECTED_ARMS,
        "policy": {
            "tau": "0x0.0p+0",
            "comparison": "strict-greater-than",
            "semantic_limits": EXPECTED_SEMANTIC_LIMITS,
            "production_limits": EXPECTED_PRODUCTION_LIMITS,
        },
    }
    if decoder != expected_decoder:
        raise ValueError("decoder differs from the literal Patch-UF V1 contract")

    limits = value.get("collection_limits")
    required_limit_fields = {
        "expected_lanes_per_shot",
        "maximum_component_records_per_shot",
        "maximum_metric_bytes_per_range",
    }
    if not isinstance(limits, Mapping) or set(limits) != required_limit_fields:
        raise ValueError("collection_limits fields are malformed")
    if limits.get("expected_lanes_per_shot") != 12:
        raise ValueError("expected_lanes_per_shot must be 12")
    if (
        limits.get("maximum_metric_bytes_per_range")
        != EXPECTED_MAX_METRIC_BYTES_PER_RANGE
    ):
        raise ValueError(
            "maximum_metric_bytes_per_range must be the frozen 512 MiB ceiling"
        )
    for name in required_limit_fields - {"expected_lanes_per_shot"}:
        raw = limits.get(name)
        if isinstance(raw, bool) or not isinstance(raw, int) or raw <= 0:
            raise ValueError(f"collection_limits.{name} must be positive")

    sampling = value.get("sampling")
    if not isinstance(sampling, Mapping):
        raise ValueError("sampling must be an object")
    if set(sampling) != {"range_count", "seed_derivation", "stages"}:
        raise ValueError("sampling fields are malformed")
    if sampling.get("range_count") != RANGE_COUNT:
        raise ValueError("sampling.range_count must be 32")
    if sampling.get("seed_derivation") != SEED_DERIVATION:
        raise ValueError("sampling.seed_derivation mismatch")
    stages = sampling.get("stages")
    if not isinstance(stages, Mapping) or set(stages) != {
        SHAKEOUT_STAGE,
        CHARACTERIZATION_STAGE,
    }:
        raise ValueError("sampling.stages must contain the two internal stage names")
    stage_roots: list[str] = []
    for name, shots in ((SHAKEOUT_STAGE, 1_000), (CHARACTERIZATION_STAGE, 10_000)):
        stage = stages[name]
        if not isinstance(stage, Mapping) or set(stage) != {"shots", "seed_root"}:
            raise ValueError(f"sampling.stages.{name} fields are malformed")
        if stage.get("shots") != shots:
            raise ValueError(f"sampling.stages.{name}.shots must be {shots}")
        root = stage.get("seed_root")
        if not is_lowercase_hex(root, length=64):
            raise ValueError(f"sampling.stages.{name}.seed_root is malformed")
        stage_roots.append(root)

    diagnostics = value.get("diagnostics")
    expected_diagnostic_fields = {
        "confidence_margin_bin_edges",
        "cluster_defect_count_display_bins",
        "bootstrap_seed_root",
        "replay_selection_seed_root",
        "bootstrap_replicates",
        "alpha",
        "maximum_cases_per_category",
    }
    if not isinstance(diagnostics, Mapping) or set(diagnostics) != expected_diagnostic_fields:
        raise ValueError("diagnostics fields are malformed")
    if diagnostics.get("confidence_margin_bin_edges") != EXPECTED_CONFIDENCE_EDGES:
        raise ValueError("diagnostics confidence-margin bins differ from V1")
    if diagnostics.get("cluster_defect_count_display_bins") != EXPECTED_CLUSTER_BINS:
        raise ValueError("diagnostics cluster display bins differ from V1")
    for key in ("bootstrap_seed_root", "replay_selection_seed_root"):
        if not is_lowercase_hex(diagnostics.get(key), length=64):
            raise ValueError(f"diagnostics.{key} is malformed")
    if diagnostics.get("bootstrap_replicates") != 10_000:
        raise ValueError("diagnostics.bootstrap_replicates must be 10000")
    if diagnostics.get("alpha") != 0.05:
        raise ValueError("diagnostics.alpha must be 0.05")
    if diagnostics.get("maximum_cases_per_category") != 100:
        raise ValueError("diagnostics.maximum_cases_per_category must be 100")

    latency_protocol = _parse_latency_protocol(value)
    if [batch.to_json() for batch in latency_protocol.batches] != EXPECTED_LATENCY_BATCHES:
        raise ValueError("latency batches differ from the frozen V1 schedule")
    if latency_protocol.host_policy.cpu_affinity != (31,):
        raise ValueError("latency CPU affinity must be exactly [31]")
    roots = [
        *stage_roots,
        f"{latency_protocol.schedule_seed:064x}",
        diagnostics["bootstrap_seed_root"],
        diagnostics["replay_selection_seed_root"],
    ]
    if len(set(roots)) != 5:
        raise ValueError("the five experiment seed roots must be pairwise distinct")

    _validate_source_path_list(value.get("source_paths"))
    if expected_status == "FROZEN":
        if value.get("campaign_lock_policy") != CAMPAIGN_LOCK_POLICY:
            raise ValueError("frozen campaign_lock_policy differs from V1")
        experiment_id = value.get("experiment_id")
        self_hash = value.get("protocol_self_sha256")
        if not is_lowercase_hex(experiment_id, length=64):
            raise ValueError("frozen experiment_id is malformed")
        if experiment_id != _experiment_id(value):
            raise ValueError("frozen experiment_id mismatch")
        if not is_lowercase_hex(self_hash, length=64):
            raise ValueError("frozen protocol self hash is malformed")
        if self_hash != canonical_protocol_self_sha256(value):
            raise ValueError("frozen protocol self hash mismatch")
    return latency_protocol


def _source_inventory(
    protocol: Mapping[str, Any], *, extra_required: Sequence[str] = ()
) -> tuple[dict[str, str], str]:
    paths = _validate_source_path_list(protocol.get("source_paths"))
    missing_extra = sorted(set(extra_required) - set(paths))
    if missing_extra:
        raise ValueError(f"source_paths omits command inputs: {missing_extra}")
    hashes: dict[str, str] = {}
    root = _REPO_ROOT.resolve()
    for relative in paths:
        unresolved = _REPO_ROOT / relative
        if unresolved.is_symlink():
            raise ValueError(f"source inventory path is a symlink: {relative}")
        candidate = unresolved.resolve()
        if root not in candidate.parents or not candidate.is_file():
            raise ValueError(f"source inventory path is not a repository file: {relative}")
        hashes[relative] = _sha256(candidate.read_bytes())
    return hashes, _json_digest(hashes)


def _prepare_protocol(protocol: Mapping[str, Any], *, stage: str) -> dict[str, Any]:
    value = copy.deepcopy(dict(protocol))
    value["status"] = "SCRATCH"
    value["frozen"] = False
    value.pop("implementation_commit", None)
    value.pop("config_commit_policy", None)
    value.pop("frozen_protocol_path", None)
    value.pop("source_hashes", None)
    value.pop("source_inventory_sha256", None)
    value.pop("gate_attestations", None)
    value.pop("template_sha256", None)
    value.pop("software_versions", None)
    value.pop("execution_environment", None)
    cell = dict(value["selected_cell"])
    cell.pop("provenance", None)
    value["selected_cell"] = cell
    source = {
        "mode": stage,
        "repository_commit": _repository_state()["implementation_commit"],
        "draft_template_sha256": _draft_digest(protocol),
    }
    value["source_identity"] = source
    value["sampling"] = {
        "range_count": RANGE_COUNT,
        "seed_derivation": SEED_DERIVATION,
        "stages": {stage: {"shots": 32, "seed_root": "00" * 32}},
    }
    value["experiment_id"] = _experiment_id(value, scratch=True)
    value["protocol_self_sha256"] = canonical_protocol_self_sha256(value)
    return value


def _scratch_protocol(
    draft: Mapping[str, Any], *, stage: str, shots: int, state: Mapping[str, Any]
) -> dict[str, Any]:
    _validate_protocol_contract(draft, expected_status="DRAFT")
    if shots < RANGE_COUNT:
        raise ValueError("scratch shots must be at least 32")
    value = _prepare_protocol(draft, stage=stage)
    scientific_root_name = (
        SHAKEOUT_STAGE if stage == "smoke" else CHARACTERIZATION_STAGE
    )
    original_root = draft["sampling"]["stages"][scientific_root_name]["seed_root"]
    scratch_root = _sha256(
        bytes.fromhex(original_root) + b"patch-uf-scratch-root\0" + stage.encode()
    )
    value["sampling"]["stages"][stage] = {
        "shots": shots,
        "seed_root": scratch_root,
    }
    value["scratch_gate"] = {
        "schema": SCRATCH_SCHEMA,
        "kind": stage,
        "shots": shots,
        "draft_template_sha256": _draft_digest(draft),
        "repository_commit": state["implementation_commit"],
        "clean_worktree": bool(state["clean_worktree"]),
        "campaign_lock_policy": CAMPAIGN_LOCK_POLICY,
    }
    value["source_identity"] = {
        "mode": stage,
        "repository_commit": state["implementation_commit"],
        "draft_template_sha256": _draft_digest(draft),
        "campaign_lock_policy": CAMPAIGN_LOCK_POLICY,
    }
    value["experiment_id"] = _experiment_id(value, scratch=True)
    value["protocol_self_sha256"] = canonical_protocol_self_sha256(value)
    return value


def _verify_scratch_gate(
    root: Path,
    *,
    kind: str,
    shots: int,
    draft_digest: str,
    implementation_commit: str,
) -> tuple[dict[str, Any], VerifiedCollection]:
    protocol = load_json_strict(root / "protocol.json", description=f"{kind} protocol")
    gate = protocol.get("scratch_gate")
    expected = {
        "schema": SCRATCH_SCHEMA,
        "kind": kind,
        "shots": shots,
        "draft_template_sha256": draft_digest,
        "repository_commit": implementation_commit,
        "clean_worktree": True,
        "campaign_lock_policy": CAMPAIGN_LOCK_POLICY,
    }
    if gate != expected:
        raise ValueError(f"{kind} scratch gate identity differs from commit A")
    if protocol.get("status") != "SCRATCH" or protocol.get("frozen") is not False:
        raise ValueError(f"{kind} is not a scratch protocol")
    if protocol.get("protocol_self_sha256") != canonical_protocol_self_sha256(protocol):
        raise ValueError(f"{kind} scratch protocol self hash mismatch")
    verified = verify_collection(
        protocol,
        stage=kind,
        out=root,
        processes=RANGE_COUNT,
        scientific=False,
    )
    if verified.summary.get("shots") != shots:
        raise ValueError(f"{kind} collection has the wrong shot count")
    attestation = {
        "kind": kind,
        "shots": shots,
        "protocol_self_sha256": protocol["protocol_self_sha256"],
        "collection_summary_payload_sha256": verified.summary["payload_sha256"],
        "selected_cell_provenance_sha256": _json_digest(
            verified.summary["provenance"]
        ),
        "campaign_lock_policy": CAMPAIGN_LOCK_POLICY,
    }
    return attestation, verified


def _metric_capacity_attestation(
    verified: VerifiedCollection, *, configured_limit: int
) -> dict[str, Any]:
    """Prove that the metric cap safely covers a full 313-shot range.

    Scratch collection divides its 100 shots over all 32 fixed workers, so a
    successful probe alone exercises only three- or four-shot ranges. Rebuild
    each authenticated probe shot's normalized metric tree, then require twice
    the largest observed byte count times the largest characterization range.
    This gate is outcome-blind and does not alter decoder decisions.
    """

    if (
        isinstance(configured_limit, bool)
        or not isinstance(configured_limit, int)
        or configured_limit <= 0
    ):
        raise ValueError("configured metric byte limit must be positive")
    lanes_by_shot: dict[int, list[dict[str, Any]]] = {}
    components_by_shot: dict[int, list[dict[str, Any]]] = {}
    for source, destination, name in (
        (verified.lane_rows, lanes_by_shot, "lane"),
        (verified.component_rows, components_by_shot, "component"),
    ):
        for raw in source:
            row = dict(raw)
            shot_id = row.pop("global_shot_id", None)
            if isinstance(shot_id, bool) or not isinstance(shot_id, int):
                raise ValueError(f"probe {name} row has malformed global_shot_id")
            destination.setdefault(shot_id, []).append(row)

    byte_counts: list[int] = []
    seen_shots: set[int] = set()
    for raw_shot in verified.shot_rows:
        shot = dict(raw_shot)
        shot_id = shot.get("global_shot_id")
        if isinstance(shot_id, bool) or not isinstance(shot_id, int):
            raise ValueError("probe shot row has malformed global_shot_id")
        if shot_id in seen_shots:
            raise ValueError("probe metric-capacity rows contain duplicate shot IDs")
        seen_shots.add(shot_id)
        metrics = shot.get("adapter_metrics")
        if not isinstance(metrics, Mapping):
            raise ValueError("probe shot row omits adapter_metrics")
        metric_tree = {
            "shot_corrections": [dict(metrics)],
            "lane_groups": [lanes_by_shot.pop(shot_id, [])],
            "component_groups": [components_by_shot.pop(shot_id, [])],
        }
        byte_counts.append(len(canonical_json_bytes(metric_tree)))
    if not byte_counts:
        raise ValueError("probe metric-capacity gate requires at least one shot")
    if lanes_by_shot or components_by_shot:
        raise ValueError("probe metric-capacity rows reference unknown shot IDs")

    observed_max = max(byte_counts)
    required_limit = (
        observed_max
        * MAX_CHARACTERIZATION_RANGE_SHOTS
        * METRIC_CAPACITY_SAFETY_FACTOR
    )
    if configured_limit < required_limit:
        raise ValueError(
            "maximum_metric_bytes_per_range is below the authenticated "
            f"probe-derived capacity requirement ({configured_limit} < "
            f"{required_limit})"
        )
    return {
        "schema": METRIC_CAPACITY_GATE_SCHEMA,
        "probe_shots": len(byte_counts),
        "observed_max_single_shot_metric_bytes": observed_max,
        "observed_total_single_shot_metric_bytes": sum(byte_counts),
        "characterization_max_range_shots": MAX_CHARACTERIZATION_RANGE_SHOTS,
        "safety_factor": METRIC_CAPACITY_SAFETY_FACTOR,
        "required_metric_bytes_per_range": required_limit,
        "configured_metric_bytes_per_range": configured_limit,
    }


def _range_metric_tree_bytes(
    component_payload: Mapping[str, Any], shot_payload: Mapping[str, Any]
) -> int:
    """Rebuild the exact normalized metric tree measured by the runtime cap."""

    shot_metrics = [dict(row["adapter_metrics"]) for row in shot_payload["shots"]]
    lane_groups: list[list[dict[str, Any]]] = []
    component_groups: list[list[dict[str, Any]]] = []
    lanes = component_payload["lanes"]
    components = component_payload["components"]
    for _, lane_start, lane_count, component_start, component_count in (
        component_payload["shot_index"]
    ):
        lane_groups.append(
            [
                {key: value for key, value in row.items() if key != "global_shot_id"}
                for row in lanes[lane_start : lane_start + lane_count]
            ]
        )
        component_groups.append(
            [
                {key: value for key, value in row.items() if key != "global_shot_id"}
                for row in components[
                    component_start : component_start + component_count
                ]
            ]
        )
    return len(
        canonical_json_bytes(
            {
                "shot_corrections": shot_metrics,
                "lane_groups": lane_groups,
                "component_groups": component_groups,
            }
        )
    )


def _capacity_probe_range():
    ranges = fixed_worker_ranges(10_000)
    return next(
        shot_range
        for shot_range in ranges
        if shot_range.shots == MAX_CHARACTERIZATION_RANGE_SHOTS
    )


def _capacity_probe_record(
    *,
    protocol: Mapping[str, Any],
    component_payload: Mapping[str, Any],
    shot_payload: Mapping[str, Any],
    component_bytes: bytes,
    shot_bytes: bytes,
) -> dict[str, Any]:
    metric_bytes = _range_metric_tree_bytes(component_payload, shot_payload)
    configured = protocol["collection_limits"][
        "maximum_metric_bytes_per_range"
    ]
    required = metric_bytes * METRIC_CAPACITY_SAFETY_FACTOR
    if configured < required:
        raise ValueError(
            "maximum_metric_bytes_per_range is below the exact 313-shot "
            f"capacity-probe requirement ({configured} < {required})"
        )
    return _payload_with_digest(
        {
            "schema": METRIC_CAPACITY_PROBE_SCHEMA,
            "schema_version": 1,
            "experiment_id": protocol["experiment_id"],
            "protocol_self_sha256": protocol["protocol_self_sha256"],
            "source_identity": protocol["source_identity"],
            "scratch_gate": protocol["scratch_gate"],
            "range": component_payload["range"],
            "provenance": component_payload["provenance"],
            "canonical_metric_tree_bytes": metric_bytes,
            "safety_factor": METRIC_CAPACITY_SAFETY_FACTOR,
            "required_metric_bytes_per_range": required,
            "configured_metric_bytes_per_range": configured,
            "raw_headroom_bytes": configured - metric_bytes,
            "safety_adjusted_headroom_bytes": configured - required,
            "component_artifact": {
                "path": _component_probe_relative_path(),
                "sha256": _sha256(component_bytes),
                "bytes": len(component_bytes),
                "canonical_payload_sha256": component_payload["payload_sha256"],
            },
            "shot_artifact": {
                "path": _shot_probe_relative_path(),
                "sha256": _sha256(shot_bytes),
                "bytes": len(shot_bytes),
                "canonical_payload_sha256": shot_payload["payload_sha256"],
            },
        }
    )


def _component_probe_relative_path() -> str:
    shot_range = _capacity_probe_range()
    return (
        "collection/component_metrics/"
        f"range-{shot_range.range_id:02d}-{shot_range.shot_start:08d}-"
        f"{shot_range.shot_stop:08d}.json.gz"
    )


def _shot_probe_relative_path() -> str:
    shot_range = _capacity_probe_range()
    return (
        "collection/shards/"
        f"range-{shot_range.range_id:02d}-{shot_range.shot_start:08d}-"
        f"{shot_range.shot_stop:08d}.json.gz"
    )


def _verify_capacity_probe(
    root: Path,
    *,
    draft: Mapping[str, Any],
    state: Mapping[str, Any],
) -> tuple[dict[str, Any], Mapping[str, Any]]:
    expected_paths = {
        "protocol.json",
        "capacity.json",
        _component_probe_relative_path(),
        _shot_probe_relative_path(),
    }
    if root.is_symlink() or not root.is_dir():
        raise ValueError("capacity-probe root must be a regular directory")
    expected_directories = {
        "collection",
        "collection/component_metrics",
        "collection/shards",
    }
    actual_paths: set[str] = set()
    actual_directories: set[str] = set()
    invalid_nodes: list[str] = []
    for path in root.rglob("*"):
        relative = path.relative_to(root).as_posix()
        if path.is_symlink() or (not path.is_file() and not path.is_dir()):
            invalid_nodes.append(relative)
        elif path.is_file():
            actual_paths.add(relative)
        else:
            actual_directories.add(relative)
    if (
        invalid_nodes
        or actual_paths != expected_paths
        or actual_directories != expected_directories
    ):
        raise ValueError("capacity-probe artifact paths are incomplete or unexpected")

    protocol = load_json_strict(
        root / "protocol.json", description="capacity-probe protocol"
    )
    expected_protocol = _scratch_protocol(
        draft,
        stage="capacity-probe",
        shots=10_000,
        state=state,
    )
    if protocol != expected_protocol:
        raise ValueError(
            "capacity-probe protocol differs from the exact draft-derived identity"
        )
    context = _collection_protocol_context(
        protocol, stage="capacity-probe", processes=1, scientific=False
    )
    component, shot, component_bytes, shot_bytes = _read_range_pair(
        out=root,
        context=context,
        shot_range=_capacity_probe_range(),
        provenance=None,
    )
    expected_record = _capacity_probe_record(
        protocol=protocol,
        component_payload=component,
        shot_payload=shot,
        component_bytes=component_bytes,
        shot_bytes=shot_bytes,
    )
    recorded = load_json_strict(
        root / "capacity.json", description="capacity-probe attestation"
    )
    _validate_payload_digest(recorded, name="capacity-probe attestation")
    if recorded != expected_record:
        raise ValueError("capacity-probe attestation does not reconcile")
    return recorded, component["provenance"]


def _run_capacity_probe(
    *,
    draft: Mapping[str, Any],
    out: Path,
    state: Mapping[str, Any],
) -> dict[str, Any]:
    _validate_protocol_contract(draft, expected_status="DRAFT")
    root, existing = validate_resumable_output_root(
        out,
        allowed_entries={"protocol.json", "capacity.json", "collection"},
        description="Patch-UF capacity probe",
    )
    if existing:
        record, _ = _verify_capacity_probe(
            root,
            draft=draft,
            state=state,
        )
        return record
    scratch = _scratch_protocol(
        draft,
        stage="capacity-probe",
        shots=10_000,
        state=state,
    )
    prepared = prepare_selected_cell(
        scratch, stage="capacity-probe", processes=1, scientific=False
    )
    artifacts = collect_prepared_range(
        prepared,
        protocol=scratch,
        stage="capacity-probe",
        shot_range=_capacity_probe_range(),
        scientific=False,
        processes=1,
    )
    record = _capacity_probe_record(
        protocol=scratch,
        component_payload=artifacts.component_payload,
        shot_payload=artifacts.shot_payload,
        component_bytes=artifacts.component_bytes,
        shot_bytes=artifacts.shot_bytes,
    )
    root.mkdir(parents=True, exist_ok=True)
    install_bytes_atomic(
        root / "protocol.json",
        canonical_json_bytes(scratch) + b"\n",
        prefix="patch-uf-capacity-protocol-",
        overwrite=False,
    )
    for relative, payload, prefix in (
        (
            _component_probe_relative_path(),
            artifacts.component_bytes,
            "patch-uf-capacity-components-",
        ),
        (
            _shot_probe_relative_path(),
            artifacts.shot_bytes,
            "patch-uf-capacity-shots-",
        ),
    ):
        destination = root / relative
        destination.parent.mkdir(parents=True, exist_ok=True)
        install_bytes_atomic(
            destination, payload, prefix=prefix, overwrite=False
        )
    _write_new_json(root / "capacity.json", record)
    verified, _ = _verify_capacity_probe(
        root,
        draft=draft,
        state=state,
    )
    return verified


def _validate_frozen_lineage(protocol: Mapping[str, Any], protocol_path: Path) -> str:
    state = _repository_state()
    if not state["clean_worktree"]:
        raise ValueError("scientific protocol verification requires a clean worktree")
    implementation = protocol.get("implementation_commit")
    if not is_lowercase_hex(implementation, length=40):
        raise ValueError("implementation_commit is malformed")
    if protocol.get("config_commit_policy") != CONFIG_COMMIT_POLICY:
        raise ValueError("config_commit_policy differs from the supported two-commit rule")
    head = state["implementation_commit"]
    if head == implementation:
        raise ValueError("frozen protocol must be committed in config-only commit B")
    ancestry = _git("merge-base", "--is-ancestor", implementation, head, check=False)
    if ancestry.returncode != 0:
        raise ValueError("implementation commit A is not an ancestor of HEAD")
    changed = _git(
        "diff", "--name-status", "--find-renames", f"{implementation}..{head}"
    ).stdout.splitlines()
    if len(changed) != 1:
        raise ValueError("A..B must contain exactly one frozen protocol file")
    pieces = changed[0].split("\t")
    if len(pieces) != 2 or pieces[0] != "A":
        raise ValueError("config commit B must add exactly one new file")
    expected_relative = protocol.get("frozen_protocol_path")
    if pieces[1] != expected_relative:
        raise ValueError("A..B changed file differs from frozen_protocol_path")
    resolved = protocol_path.resolve()
    try:
        actual_relative = resolved.relative_to(_REPO_ROOT.resolve()).as_posix()
    except ValueError as ex:
        raise ValueError("frozen protocol must live inside the repository") from ex
    if actual_relative != expected_relative:
        raise ValueError("runtime protocol path differs from frozen_protocol_path")
    if (
        resolved.parent != (_REPO_ROOT / "docs").resolve()
        or resolved.suffix != ".json"
        or "FROZEN" not in resolved.name
    ):
        raise ValueError("frozen protocol path must be docs/*FROZEN*.json")
    return head


def _validate_frozen_sources(protocol: Mapping[str, Any]) -> None:
    hashes = protocol.get("source_hashes")
    paths = _validate_source_path_list(protocol.get("source_paths"))
    if not isinstance(hashes, Mapping) or set(hashes) != set(paths):
        raise ValueError("source_hashes must exactly cover source_paths")
    if protocol.get("source_inventory_sha256") != _json_digest(dict(hashes)):
        raise ValueError("source inventory digest mismatch")
    root = _REPO_ROOT.resolve()
    for relative in paths:
        path = (_REPO_ROOT / relative)
        if path.is_symlink():
            raise ValueError(f"source path became a symlink: {relative}")
        resolved = path.resolve()
        if root not in resolved.parents or not resolved.is_file():
            raise ValueError(f"source path is no longer a regular file: {relative}")
        if _sha256(resolved.read_bytes()) != hashes[relative]:
            raise ValueError(f"source hash mismatch for {relative}")


def _verify_frozen_protocol(
    protocol: Mapping[str, Any],
    *,
    protocol_path: Path,
    authenticate_cell: bool = True,
) -> tuple[dict[str, Any], PreparedCell | None]:
    latency_protocol = _validate_protocol_contract(
        protocol, expected_status="FROZEN"
    )
    integrated_latency_protocol = latency_protocol_from_experiment(protocol, cpu=31)
    if integrated_latency_protocol != latency_protocol:
        raise ValueError("CLI and integration latency protocol mappings disagree")
    config_commit = _validate_frozen_lineage(protocol, protocol_path)
    _validate_frozen_sources(protocol)
    if protocol.get("software_versions") != _software_versions():
        raise ValueError("runtime software versions differ from frozen protocol")
    if protocol.get("execution_environment") != _execution_environment():
        raise ValueError("runtime execution environment differs from frozen protocol")
    actual_policy = capture_host_policy(cpu=31)
    if latency_protocol.host_policy != actual_policy:
        raise ValueError("latency host policy differs from current CPU-31 host identity")
    expected_source_identity = {
        "implementation_commit": protocol["implementation_commit"],
        "config_commit_policy": CONFIG_COMMIT_POLICY,
        "frozen_protocol_path": protocol["frozen_protocol_path"],
        "source_inventory_sha256": protocol["source_inventory_sha256"],
        "campaign_lock_policy": CAMPAIGN_LOCK_POLICY,
    }
    if protocol.get("source_identity") != expected_source_identity:
        raise ValueError("source_identity differs from frozen lineage")
    prepared = None
    if authenticate_cell:
        prepared = prepare_selected_cell(
            protocol,
            stage=SHAKEOUT_STAGE,
            processes=RANGE_COUNT,
            scientific=True,
        )
    report = {
        "valid": True,
        "experiment_id": protocol["experiment_id"],
        "protocol_self_sha256": protocol["protocol_self_sha256"],
        "implementation_commit": protocol["implementation_commit"],
        "config_commit": config_commit,
        "frozen_protocol_path": protocol["frozen_protocol_path"],
        "source_inventory_sha256": protocol["source_inventory_sha256"],
        "selected_cell_provenance": (
            dict(prepared.provenance)
            if prepared is not None
            else dict(protocol["selected_cell"]["provenance"])
        ),
    }
    return report, prepared


def _freeze(
    draft: Mapping[str, Any],
    *,
    draft_path: Path,
    smoke_root: Path,
    probe_root: Path,
    capacity_root: Path,
    out_protocol: Path,
    tmp_root: Path,
) -> dict[str, Any]:
    _validate_protocol_contract(draft, expected_status="DRAFT")
    state = _repository_state()
    if not state["clean_worktree"]:
        raise ValueError("freeze requires a clean worktree at implementation commit A")
    output = out_protocol.absolute()
    if output.exists() or output.is_symlink():
        raise FileExistsError("frozen protocol output must be a new path")
    resolved_parent = output.parent.resolve()
    if (
        resolved_parent != (_REPO_ROOT / "docs").resolve()
        or output.suffix != ".json"
        or "FROZEN" not in output.name
    ):
        raise ValueError("--out-protocol must be a new docs/*FROZEN*.json path")
    try:
        output_relative = output.resolve().relative_to(_REPO_ROOT.resolve()).as_posix()
        draft_relative = draft_path.resolve().relative_to(_REPO_ROOT.resolve()).as_posix()
    except ValueError as ex:
        raise ValueError("draft and frozen protocol must live in the repository") from ex
    smoke_root = _require_under(smoke_root, tmp_root, name="smoke root")
    probe_root = _require_under(probe_root, tmp_root, name="probe root")
    capacity_root = _require_under(
        capacity_root, tmp_root, name="capacity-probe root"
    )
    template_digest = _draft_digest(draft)
    smoke_attestation, smoke = _verify_scratch_gate(
        smoke_root,
        kind="smoke",
        shots=32,
        draft_digest=template_digest,
        implementation_commit=state["implementation_commit"],
    )
    probe_attestation, probe = _verify_scratch_gate(
        probe_root,
        kind="probe",
        shots=100,
        draft_digest=template_digest,
        implementation_commit=state["implementation_commit"],
    )
    probe_attestation["metric_capacity"] = _metric_capacity_attestation(
        probe,
        configured_limit=draft["collection_limits"][
            "maximum_metric_bytes_per_range"
        ],
    )
    capacity_attestation, capacity_provenance = _verify_capacity_probe(
        capacity_root,
        draft=draft,
        state=state,
    )
    if not (
        smoke.summary["provenance"]
        == probe.summary["provenance"]
        == capacity_provenance
    ):
        raise ValueError(
            "smoke, probe, and capacity-probe selected-cell provenances disagree"
        )

    prepare_protocol = _prepare_protocol(draft, stage="freeze-inspect")
    prepared = prepare_selected_cell(
        prepare_protocol,
        stage="freeze-inspect",
        processes=1,
        scientific=False,
    )
    if dict(prepared.provenance) != smoke.summary["provenance"]:
        raise ValueError("fresh selected-cell provenance differs from scratch gates")

    source_hashes, source_inventory_sha256 = _source_inventory(
        draft, extra_required=(draft_relative,)
    )
    latency_protocol = _parse_latency_protocol(draft)
    if latency_protocol.host_policy != capture_host_policy(cpu=31):
        raise ValueError("draft latency host policy differs from current CPU-31 host")

    frozen = copy.deepcopy(dict(draft))
    frozen["status"] = "FROZEN"
    frozen["frozen"] = True
    frozen["implementation_commit"] = state["implementation_commit"]
    frozen["config_commit_policy"] = CONFIG_COMMIT_POLICY
    frozen["frozen_protocol_path"] = output_relative
    frozen["template_sha256"] = template_digest
    frozen["source_hashes"] = source_hashes
    frozen["source_inventory_sha256"] = source_inventory_sha256
    frozen["gate_attestations"] = {
        "smoke_32": smoke_attestation,
        "probe_100": probe_attestation,
        "capacity_probe_313": capacity_attestation,
    }
    frozen["software_versions"] = _software_versions()
    frozen["execution_environment"] = _execution_environment()
    frozen["campaign_lock_policy"] = CAMPAIGN_LOCK_POLICY
    frozen["source_identity"] = {
        "implementation_commit": state["implementation_commit"],
        "config_commit_policy": CONFIG_COMMIT_POLICY,
        "frozen_protocol_path": output_relative,
        "source_inventory_sha256": source_inventory_sha256,
        "campaign_lock_policy": CAMPAIGN_LOCK_POLICY,
    }
    cell = dict(frozen["selected_cell"])
    cell["provenance"] = dict(prepared.provenance)
    frozen["selected_cell"] = cell
    frozen["experiment_id"] = _experiment_id(frozen)
    frozen["protocol_self_sha256"] = canonical_protocol_self_sha256(frozen)
    _validate_protocol_contract(frozen, expected_status="FROZEN")
    _write_new_json(output, frozen)
    return frozen


