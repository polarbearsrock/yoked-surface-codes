        }
    )


def _validate_restart_suite(
    *,
    root: Path,
    latency_protocol: LatencyProtocol,
    suite_identity: Mapping[str, Any],
) -> dict[str, Any]:
    protocol_json = latency_protocol.to_json()
    protocol_id = _latency._json_digest(protocol_json)
    workload_id = _latency._json_digest(dict(suite_identity))
    suite_id = _latency._json_digest(
        {
            "protocol_id": protocol_id,
            "workload_id": workload_id,
            "fresh_process_per_restart": True,
            "timed_restart_concurrency": 1,
        }
    )
    expected_names = {
        "protocol.json",
        "suite.json",
        *(
            _latency._restart_name(batch.batch_size, restart)
            for batch in latency_protocol.batches
            for restart in range(batch.restarts)
        ),
    }
    validated_root, actual = validate_resumable_output_root(
        root,
        allowed_entries=expected_names,
        description="Patch-UF latency restart suite",
    )
    if actual != frozenset(expected_names):
        raise ValueError("latency restart suite is incomplete")
    if load_json_strict(
        validated_root / "protocol.json", description="latency protocol"
    ) != protocol_json:
        raise ValueError("latency restart protocol differs from frozen schedule")
    ledger_names: list[str] = []
    ledger_digests: dict[str, str] = {}
    for batch in latency_protocol.batches:
        for restart in range(batch.restarts):
            name = _latency._restart_name(batch.batch_size, restart)
            path = validated_root / name
            record = load_json_strict(path, description="latency restart ledger")
            _latency._validate_existing_restart(
                record,
                protocol_id=protocol_id,
                suite_id=suite_id,
                workload_id=workload_id,
                batch=batch,
                restart=restart,
            )
            ledger_names.append(name)
            ledger_digests[name] = _sha256(path.read_bytes())
    expected_suite = {
        "schema": _latency.SUITE_SCHEMA,
        "protocol_id": protocol_id,
        "suite_id": suite_id,
        "workload_id": workload_id,
        "workload_identity": dict(suite_identity),
        "fresh_process_per_restart": True,
        "timed_restart_concurrency": 1,
        "affinity_policy": latency_protocol.host_policy.to_json(),
        "restart_ledgers": ledger_names,
        "restart_ledger_sha256": ledger_digests,
    }
    if load_json_strict(
        validated_root / "suite.json", description="latency suite"
    ) != expected_suite:
        raise ValueError("latency suite summary does not reconcile")
    return expected_suite


def _run_latency(
    *,
    protocol: Mapping[str, Any],
    protocol_path: Path,
    collection: Path,
    out: Path,
    prepared: PreparedCell,
) -> dict[str, Any]:
    del protocol_path
    latency_protocol = latency_protocol_from_experiment(protocol, cpu=31)
    verified = verify_collection(
        protocol,
        stage=CHARACTERIZATION_STAGE,
        out=collection,
        processes=RANGE_COUNT,
        scientific=True,
    )
    root = out.absolute()
    corpus_root, source_path = _latency_sidecar_paths(root)
    if corpus_root.is_symlink() or source_path.is_symlink():
        raise ValueError("latency sidecars may not be symlinks")
    corpus_manifest = corpus_root / "manifest.json"
    if not corpus_root.exists():
        corpus_manifest = materialize_latency_corpus_from_characterization(
            protocol,
            characterization_dir=collection,
            out_dir=corpus_root,
            scientific=True,
            processes=RANGE_COUNT,
            prepared=prepared,
        )
    corpus = load_authenticated_latency_corpus(corpus_manifest)
    materialization = json.loads(corpus.provenance_json)
    source_corpus_identity = verified.corpus_identity
    if not isinstance(source_corpus_identity, Mapping):
        raise ValueError("characterization collection omits detector corpus identity")
    source_detector_sha256 = source_corpus_identity.get("detectors_sha256")
    if (
        materialization.get("schema") != MATERIALIZATION_SCHEMA
        or materialization.get("source_detector_sha256") != source_detector_sha256
        or materialization.get("source_collection_summary_payload_sha256")
        != verified.summary["payload_sha256"]
        or materialization.get("shot_count") != len(verified.shot_rows)
    ):
        raise ValueError("latency materialization differs from characterization")
    factory = YokedPatchUFLatencyFactory(
        protocol=protocol,
        corpus_manifest_path=str(corpus_manifest.resolve()),
        scientific=True,
        processes=RANGE_COUNT,
    )
    suite = run_latency_suite(
        factory,
        protocol=latency_protocol,
        out_dir=root,
        resume=True,
    )
    corpus_identity = _corpus_identity_record(
        protocol=protocol,
        corpus=corpus,
        source_detector_sha256=str(source_detector_sha256),
        collection=collection,
        collection_summary_sha256=verified.summary["payload_sha256"],
        suite_root=root,
        suite=suite,
    )
    _install_or_compare_json(
        source_path,
        corpus_identity,
        name="latency corpus identity",
    )
    return {
        "suite": suite,
        "suite_path": str(root.resolve()),
        "workload_path": str(corpus_root.resolve()),
        "source_identity_path": str(source_path.resolve()),
        "source_identity_payload_sha256": corpus_identity["payload_sha256"],
    }


def _verify_latency(
    *,
    protocol: Mapping[str, Any],
    input_root: Path,
    collection_override: Path | None,
    prepared: PreparedCell,
) -> dict[str, Any]:
    root = input_root.absolute()
    corpus_root, source_path = _latency_sidecar_paths(root)
    if corpus_root.is_symlink() or source_path.is_symlink():
        raise ValueError("latency sidecars may not be symlinks")
    corpus_identity = load_json_strict(
        source_path, description="latency corpus identity"
    )
    _validate_payload_digest(corpus_identity, name="latency corpus identity")
    stored_collection = corpus_identity.get("source_collection_path")
    if not isinstance(stored_collection, str) or not stored_collection:
        raise ValueError("latency corpus identity omits source collection path")
    collection = (
        collection_override.resolve()
        if collection_override is not None
        else Path(stored_collection).resolve()
    )
    verified = verify_collection(
        protocol,
        stage=CHARACTERIZATION_STAGE,
        out=collection,
        processes=RANGE_COUNT,
        scientific=True,
    )
    corpus_manifest = corpus_root / "manifest.json"
    corpus = load_authenticated_latency_corpus(corpus_manifest)
    factory = YokedPatchUFLatencyFactory(
        protocol=protocol,
        corpus_manifest_path=str(corpus_manifest.resolve()),
        scientific=True,
        processes=RANGE_COUNT,
    )
    materialization = json.loads(corpus.provenance_json)
    source_corpus_identity = verified.corpus_identity
    if not isinstance(source_corpus_identity, Mapping):
        raise ValueError("characterization collection omits detector corpus identity")
    source_detector_sha256 = source_corpus_identity.get("detectors_sha256")
    if (
        materialization.get("schema") != MATERIALIZATION_SCHEMA
        or materialization.get("source_detector_sha256") != source_detector_sha256
        or materialization.get("source_collection_summary_payload_sha256")
        != verified.summary["payload_sha256"]
        or materialization.get("shot_count") != len(verified.shot_rows)
    ):
        raise ValueError("latency materialization differs from characterization")
    latency_protocol = latency_protocol_from_experiment(protocol, cpu=31)
    identity = dict(factory.suite_identity)
    suite = _validate_restart_suite(
        root=root,
        latency_protocol=latency_protocol,
        suite_identity=identity,
    )
    expected_corpus_identity = _corpus_identity_record(
        protocol=protocol,
        corpus=corpus,
        source_detector_sha256=str(source_detector_sha256),
        collection=Path(stored_collection),
        collection_summary_sha256=verified.summary["payload_sha256"],
        suite_root=root,
        suite=suite,
    )
    if corpus_identity != expected_corpus_identity:
        raise ValueError("latency corpus identity differs from characterization")
    return {
        "valid": True,
        "experiment_id": protocol["experiment_id"],
        "suite_id": suite["suite_id"],
        "workload_id": suite["workload_id"],
        "corpus_rows": corpus.row_count,
        "restart_ledgers": len(suite["restart_ledgers"]),
        "source_identity_payload_sha256": corpus_identity["payload_sha256"],
    }


def _run_casebook_replay(
    *,
    protocol: Mapping[str, Any],
    stage: str,
    collection: Path,
    analysis: Path,
    out: Path,
    worker_processes: int,
) -> dict[str, Any]:
    root, existing = validate_resumable_output_root(
        out,
        allowed_entries={"replay.json"},
        description="Patch-UF casebook replay bundle",
    )
    if existing not in (frozenset(), frozenset({"replay.json"})):
        raise ValueError("casebook replay bundle has unexpected entries")
    summary = replay_casebook_in_fresh_process(
        protocol,
        collection_out=collection,
        analysis_path=analysis,
        stage=stage,
        processes=RANGE_COUNT,
        worker_processes=worker_processes,
        scientific=True,
    )
    if (
        summary.get("schema") != REPLAY_SCHEMA
        or summary.get("status") != "reconciled"
        or summary.get("replayed_cases") != len(summary.get("cases", ()))
    ):
        raise ValueError("casebook replay did not reconcile every retained shot")
    root.mkdir(parents=True, exist_ok=True)
    path = root / "replay.json"
    payload = canonical_json_bytes(summary) + b"\n"
    if path.exists():
        if path.is_symlink() or not path.is_file() or path.read_bytes() != payload:
            raise ValueError("existing casebook replay bundle differs")
    else:
        install_bytes_atomic(
            path,
            payload,
            prefix="patch-uf-casebook-replay-",
            overwrite=False,
        )
    return {
        "valid": True,
        "replay_path": str(path.resolve()),
        "payload_sha256": summary["payload_sha256"],
        "replayed_cases": summary["replayed_cases"],
        "worker_processes": summary["worker_processes"],
    }


def _parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        description=(
            "Confidence-Gated Patch Union-Find plus residual Global-MWPM "
            "experiment harness"
        )
    )
    commands = parser.add_subparsers(dest="command", required=True)

    inspect = commands.add_parser(
        "inspect", help="compile and report draft cell/source provenance without sampling"
    )
    inspect.add_argument("--protocol", type=Path, required=True)

    smoke = commands.add_parser(
        "smoke", help="run the fixed non-scientific 32-shot integration gate"
    )
    smoke.add_argument("--protocol", type=Path, required=True)
    smoke.add_argument("--out", type=Path, required=True)
    smoke.add_argument("--processes", type=int, default=32)

    probe = commands.add_parser(
        "probe", help="run a bounded non-scientific storage/runtime probe"
    )
    probe.add_argument("--protocol", type=Path, required=True)
    probe.add_argument("--shots", type=int, default=100)
    probe.add_argument("--out", type=Path, required=True)
    probe.add_argument("--processes", type=int, default=32)

    capacity_probe = commands.add_parser(
        "capacity-probe",
        help="run one exact 313-shot normalized-telemetry range preflight",
    )
    capacity_probe.add_argument("--protocol", type=Path, required=True)
    capacity_probe.add_argument("--out", type=Path, required=True)

    freeze = commands.add_parser(
        "freeze", help="freeze a clean commit-A draft after scratch gates"
    )
    freeze.add_argument("--draft", type=Path, required=True)
    freeze.add_argument("--smoke-root", type=Path, required=True)
    freeze.add_argument("--probe-root", type=Path, required=True)
    freeze.add_argument("--capacity-root", type=Path, required=True)
    freeze.add_argument("--out-protocol", type=Path, required=True)

    verify_protocol = commands.add_parser(
        "verify-protocol", help="verify two-commit lineage, sources, host, and cell"
    )
    verify_protocol.add_argument("--protocol", type=Path)
    verify_protocol.add_argument(
        "--describe",
        action="store_true",
        help="print the exact draft/frozen field contract",
    )

    for command, help_text in (
        ("collect", "collect or resume one fixed scientific stage"),
        ("verify-collection", "read-only verification of one scientific stage"),
    ):
        sub = commands.add_parser(command, help=help_text)
        sub.add_argument("--stage", choices=tuple(STAGE_ALIASES), required=True)
        sub.add_argument("--protocol", type=Path, required=True)
        sub.add_argument(
            "--out" if command == "collect" else "--input",
            type=Path,
            required=True,
        )
        if command == "collect":
            sub.add_argument("--processes", type=int, default=32)

    latency = commands.add_parser(
        "latency", help="run serialized fresh-process timing on characterization rows"
    )
    latency.add_argument("--protocol", type=Path, required=True)
    latency.add_argument("--collection", type=Path, required=True)
    latency.add_argument("--out", type=Path, required=True)

    verify_latency = commands.add_parser(
        "verify-latency", help="read-only verification of corpus and restart ledgers"
    )
    verify_latency.add_argument("--protocol", type=Path, required=True)
    verify_latency.add_argument("--input", type=Path, required=True)
    verify_latency.add_argument(
        "--collection",
        type=Path,
        help="optional relocated characterization collection path",
    )
    replay = commands.add_parser(
        "replay", help="fresh-process bit-exact replay of an authenticated casebook"
    )
    replay.add_argument("--stage", choices=tuple(STAGE_ALIASES), required=True)
    replay.add_argument("--protocol", type=Path, required=True)
    replay.add_argument("--collection", type=Path, required=True)
    replay.add_argument("--analysis", type=Path, required=True)
    replay.add_argument("--processes", type=int, default=32)
    replay.add_argument("--out", type=Path, required=True)
    return parser


def main(argv: Sequence[str] | None = None) -> int:
    args = _parser().parse_args(argv)
    campaign_lease: _CampaignLockLease | None = None
    try:
        tmp_root = _require_tmpdir()
        if args.command in {
            "smoke",
            "probe",
            "capacity-probe",
            "collect",
            "latency",
            "replay",
        }:
            campaign_lease = _acquire_campaign_lock(
                tmp_root,
                command=args.command,
                target=args.out,
            )
        configure_single_thread_runtime()
        _reject_max_errors()

        if args.command == "verify-protocol" and args.protocol is None:
            if not args.describe:
                raise ValueError("verify-protocol requires --protocol or --describe")
            _print_json({"protocol_contract": _protocol_contract()})
            return 0

        if args.command == "inspect":
            protocol = load_json_strict(args.protocol, description="Patch-UF protocol")
            _validate_protocol_contract(protocol, expected_status="DRAFT")
            inventory, inventory_digest = _source_inventory(protocol)
            prepared_protocol = _prepare_protocol(protocol, stage="inspect")
            prepared = prepare_selected_cell(
                prepared_protocol,
                stage="inspect",
                processes=1,
                scientific=False,
            )
            _print_json(
                {
                    "protocol_contract": _protocol_contract(),
                    "repository": _repository_state(),
                    "draft_template_sha256": _draft_digest(protocol),
                    "source_hashes": inventory,
                    "source_inventory_sha256": inventory_digest,
                    "selected_cell_provenance": dict(prepared.provenance),
                    "captured_cpu31_host_policy": capture_host_policy(cpu=31).to_json(),
                }
            )
            return 0

        if args.command in {"smoke", "probe"}:
            processes = _validate_processes(args.processes, scientific=False)
            shots = 32 if args.command == "smoke" else args.shots
            if args.command == "probe" and not 32 <= shots <= 10_000:
                raise ValueError("probe --shots must be in [32, 10000]")
            out = _require_under(args.out, tmp_root, name=f"{args.command} output")
            draft = load_json_strict(args.protocol, description="Patch-UF draft")
            scratch = _scratch_protocol(
                draft,
                stage=args.command,
                shots=shots,
                state=_repository_state(),
            )
            summary = run_collection(
                scratch,
                stage=args.command,
                out=out,
                processes=processes,
                scientific=False,
            )
            _print_json(summary)
            return 0

        if args.command == "capacity-probe":
            out = _require_under(
                args.out, tmp_root, name="capacity-probe output"
            )
            draft = load_json_strict(args.protocol, description="Patch-UF draft")
            result = _run_capacity_probe(
                draft=draft,
                out=out,
                state=_repository_state(),
            )
            _print_json(result)
            return 0

        if args.command == "freeze":
            draft = load_json_strict(args.draft, description="Patch-UF draft")
            frozen = _freeze(
                draft,
                draft_path=args.draft,
                smoke_root=args.smoke_root,
                probe_root=args.probe_root,
                capacity_root=args.capacity_root,
                out_protocol=args.out_protocol,
                tmp_root=tmp_root,
            )
            _print_json(
                {
                    "wrote": str(args.out_protocol),
                    "experiment_id": frozen["experiment_id"],
                    "protocol_self_sha256": frozen["protocol_self_sha256"],
                    "implementation_commit": frozen["implementation_commit"],
                    "next_step": "commit only the frozen JSON as config commit B",
                }
            )
            return 0

        protocol = load_json_strict(args.protocol, description="frozen Patch-UF protocol")
        report, prepared = _verify_frozen_protocol(
            protocol,
            protocol_path=args.protocol,
            authenticate_cell=True,
        )
        assert prepared is not None

        if args.command == "verify-protocol":
            report["protocol_contract"] = _protocol_contract()
            _print_json(report)
            return 0

        if args.command == "collect":
            processes = _validate_processes(args.processes, scientific=True)
            summary = run_collection(
                protocol,
                stage=STAGE_ALIASES[args.stage],
                out=args.out,
                processes=processes,
                scientific=True,
                prepared=prepared,
            )
            _print_json(summary)
            return 0

        if args.command == "verify-collection":
            verified = verify_collection(
                protocol,
                stage=STAGE_ALIASES[args.stage],
                out=args.input,
                processes=RANGE_COUNT,
                scientific=True,
            )
            _print_json(
                {
                    "valid": True,
                    "summary": verified.summary,
                    "shot_rows": len(verified.shot_rows),
                    "lane_rows": len(verified.lane_rows),
                    "component_rows": len(verified.component_rows),
                }
            )
            return 0

        if args.command == "latency":
            manifest = _run_latency(
                protocol=protocol,
                protocol_path=args.protocol,
                collection=args.collection,
                out=args.out,
                prepared=prepared,
            )
            _print_json(manifest)
            return 0

        if args.command == "verify-latency":
            result = _verify_latency(
                protocol=protocol,
                input_root=args.input,
                collection_override=args.collection,
                prepared=prepared,
            )
            _print_json(result)
            return 0

        if args.command == "replay":
            worker_processes = _validate_processes(
                args.processes, scientific=False
            )
            result = _run_casebook_replay(
                protocol=protocol,
                stage=STAGE_ALIASES[args.stage],
                collection=args.collection,
                analysis=args.analysis,
                out=args.out,
                worker_processes=worker_processes,
            )
            _print_json(result)
            return 0
        raise AssertionError(f"unhandled command {args.command!r}")
    except (
        FileExistsError,
        KeyError,
        OSError,
        RuntimeError,
        subprocess.CalledProcessError,
        TypeError,
        ValueError,
    ) as ex:
        print(f"error: {ex}", file=sys.stderr)
        return 2
    finally:
        if campaign_lease is not None:
            campaign_lease.release()


if __name__ == "__main__":
    raise SystemExit(main())
