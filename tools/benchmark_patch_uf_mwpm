def _experiment_id(protocol: Mapping[str, Any], *, scratch: bool = False) -> str:
    value = copy.deepcopy(dict(protocol))
    value.pop("experiment_id", None)
    value.pop("protocol_self_sha256", None)
    domain = SCRATCH_ID_DOMAIN if scratch else EXPERIMENT_ID_DOMAIN
    return _sha256(domain + canonical_json_bytes(value))


def _draft_digest(protocol: Mapping[str, Any]) -> str:
    value = copy.deepcopy(dict(protocol))
    for key in (
        "experiment_id",
        "protocol_self_sha256",
        "source_hashes",
        "source_inventory_sha256",
        "implementation_commit",
        "config_commit_policy",
        "frozen_protocol_path",
        "template_sha256",
        "gate_attestations",
        "software_versions",
        "execution_environment",
        "source_identity",
    ):
        value.pop(key, None)
    cell = value.get("selected_cell")
    if isinstance(cell, Mapping):
        cell = dict(cell)
        cell.pop("provenance", None)
        value["selected_cell"] = cell
    value["status"] = "DRAFT"
    value["frozen"] = False
    return _json_digest(value)


def _reject_tbd(value: Any, *, path: str = "$") -> None:
    if isinstance(value, str) and "TBD" in value.upper():
        raise ValueError(f"unresolved TBD at {path}")
    if isinstance(value, Mapping):
        for key, child in value.items():
            _reject_tbd(child, path=f"{path}.{key}")
    elif isinstance(value, list):
        for index, child in enumerate(value):
            _reject_tbd(child, path=f"{path}[{index}]")


