def _sha256(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


def _json_digest(value: Any) -> str:
    return _sha256(canonical_json_bytes(value))


def _payload_with_digest(value: Mapping[str, Any]) -> dict[str, Any]:
    result = dict(value)
    if "payload_sha256" in result:
        raise ValueError("payload_sha256 is reserved")
    result["payload_sha256"] = _json_digest(result)
    return result


def _validate_payload_digest(value: Mapping[str, Any], *, name: str) -> None:
    claimed = value.get("payload_sha256")
    if not is_lowercase_hex(claimed, length=64):
        raise ValueError(f"{name} payload_sha256 is malformed")
    unsigned = dict(value)
    del unsigned["payload_sha256"]
    if _json_digest(unsigned) != claimed:
        raise ValueError(f"{name} payload digest mismatch")


def _print_json(value: Any) -> None:
    print(json.dumps(value, indent=2, sort_keys=True, allow_nan=False))


def _write_new_json(path: Path, value: Mapping[str, Any]) -> None:
    payload = (
        json.dumps(value, indent=2, sort_keys=True, allow_nan=False) + "\n"
    ).encode("utf-8")
    install_bytes_atomic(
        path,
        payload,
        prefix="patch-uf-new-json-",
        overwrite=False,
    )


def _install_or_compare_json(path: Path, value: Mapping[str, Any], *, name: str) -> None:
    if path.exists():
        if load_json_strict(path, description=name) != dict(value):
            raise ValueError(f"existing {name} differs")
        return
    install_bytes_atomic(
        path,
        canonical_json_bytes(dict(value)) + b"\n",
        prefix="patch-uf-cli-json-",
        overwrite=False,
    )


def _require_tmpdir() -> Path:
    raw = os.environ.get("TMPDIR")
    if not raw:
        raise ValueError("TMPDIR must be set for Patch-UF experiment commands")
    root = Path(raw)
    if not root.is_absolute():
        raise ValueError("TMPDIR must be an absolute path")
    root.mkdir(parents=True, exist_ok=True)
    if root.is_symlink() or not root.is_dir():
        raise ValueError("TMPDIR must be a regular directory, not a symlink")
    os.environ.setdefault(
        "MPLCONFIGDIR", str(root / "yoked-surface-codes-matplotlib")
    )
    Path(os.environ["MPLCONFIGDIR"]).mkdir(parents=True, exist_ok=True)
    return root.resolve()


def _require_under(path: Path, root: Path, *, name: str) -> Path:
    candidate = path.absolute()
    if candidate.is_symlink():
        raise ValueError(f"{name} may not be a symlink")
    resolved = candidate.resolve()
    if resolved != root and root not in resolved.parents:
        raise ValueError(f"{name} must be under {root}")
    return resolved


