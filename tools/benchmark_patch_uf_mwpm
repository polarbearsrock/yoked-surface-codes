def _validate_processes(value: int, *, scientific: bool) -> int:
    if isinstance(value, bool) or not isinstance(value, int) or value <= 0:
        raise ValueError("--processes must be a positive integer")
    if value > RANGE_COUNT:
        raise ValueError("--processes exceeds the hard maximum of 32")
    if scientific and value != RANGE_COUNT:
        raise ValueError("scientific collection requires exactly 32 processes")
    return value


def _git(*args: str, check: bool = True) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        ["git", *args],
        cwd=_REPO_ROOT,
        check=check,
        capture_output=True,
        text=True,
    )


def _repository_state() -> dict[str, Any]:
    head = _git("rev-parse", "HEAD").stdout.strip()
    status = _git("status", "--porcelain", "--untracked-files=all").stdout
    if not is_lowercase_hex(head, length=40):
        raise ValueError("repository HEAD is not a 40-character Git object ID")
    return {
        "implementation_commit": head,
        "clean_worktree": status == "",
        "porcelain": status.splitlines(),
    }


