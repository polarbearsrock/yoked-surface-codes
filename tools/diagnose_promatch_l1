# --------------------------------------------------------------------------- io


def _unique_object(pairs):
    result = {}
    for key, value in pairs:
        if key in result:
            raise ValueError(f"duplicate JSON object key {key!r}")
        result[key] = value
    return result


def _load_json(path: Path) -> Any:
    with path.open(encoding="utf-8") as f:
        return json.load(f, object_pairs_hook=_unique_object)


def _unpack(hexstr: str, count: int) -> np.ndarray:
    packed = np.frombuffer(bytes.fromhex(hexstr), dtype=np.uint8)
    return np.unpackbits(packed, bitorder="little", count=count).astype(np.uint8)


def _sha256_file(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def _canonical_json_bytes(value: Any) -> bytes:
    return json.dumps(
        _jsonable(value),
        sort_keys=True,
        ensure_ascii=False,
        allow_nan=False,
        separators=(",", ":"),
    ).encode("utf-8")


def _require_exact_keys(value: Any, expected: set[str], *, label: str) -> dict[str, Any]:
    if not isinstance(value, dict):
        raise ValueError(f"{label} must be a JSON object")
    actual = set(value)
    if actual != expected:
        raise ValueError(
            f"{label} fields differ: missing={sorted(expected - actual)}, "
            f"extra={sorted(actual - expected)}"
        )
    return value


def _resolve_frozen_path(raw: Any, *, label: str) -> Path:
    if not isinstance(raw, str) or not raw:
        raise ValueError(f"{label} must be a nonempty path string")
    path = Path(raw)
    return (path if path.is_absolute() else _ROOT / path).resolve()


def _git_output(*args: str) -> str:
    completed = subprocess.run(
        ("git", "-C", str(_ROOT), *args),
        check=True,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )
    return completed.stdout.strip()


def _validate_frozen_oracle_config(config: dict[str, Any]) -> dict[str, Any]:
    _require_exact_keys(
        config,
        {
            "schema", "status", "frozen", "input", "selection", "oracle",
            "arms", "decoder", "implementation", "experiment_id", "processes",
            "native_threads_per_process", "software_versions",
        },
        label="oracle replay config",
    )
    if config["schema"] != ORACLE_REPLAY_CONFIG_SCHEMA:
        raise ValueError(f"oracle replay config schema must be {ORACLE_REPLAY_CONFIG_SCHEMA!r}")
    if config["status"] != "FROZEN" or config["frozen"] is not True:
        raise ValueError("oracle replay config must have status='FROZEN' and frozen=true")
    recorded_experiment_id = config["experiment_id"]
    if not isinstance(recorded_experiment_id, str) or len(recorded_experiment_id) != 64:
        raise ValueError("oracle replay experiment_id must be 64 hex characters")
    semantic = dict(config)
    del semantic["experiment_id"]
    computed_experiment_id = hashlib.sha256(_canonical_json_bytes(semantic)).hexdigest()
    if recorded_experiment_id != computed_experiment_id:
        raise ValueError("oracle replay experiment_id does not match its canonical semantic config")
    if config["processes"] != 1 or config["native_threads_per_process"] != 1:
        raise ValueError("oracle replay must freeze one process and one native thread")
    runtime_versions = current_software_versions()
    _require_exact_keys(
        config["software_versions"], set(runtime_versions),
        label="oracle replay software_versions",
    )
    if config["software_versions"] != runtime_versions:
        raise ValueError(
            "oracle replay runtime versions differ from the frozen versions: "
            f"expected={config['software_versions']}, actual={runtime_versions}"
        )

    input_cfg = _require_exact_keys(
        config["input"],
        {"path", "experiment_id", "protocol_sha256", "summary_sha256"},
        label="oracle replay config input",
    )
    for name in ("experiment_id", "protocol_sha256", "summary_sha256"):
        value = input_cfg[name]
        if not isinstance(value, str) or len(value) != 64:
            raise ValueError(f"oracle replay config input.{name} must be 64 hex characters")
        try:
            bytes.fromhex(value)
        except ValueError as ex:
            raise ValueError(f"oracle replay config input.{name} is not hexadecimal") from ex

    selection = _require_exact_keys(
        config["selection"], {"cell_ids", "categories"}, label="oracle replay selection"
    )
    cell_ids = selection["cell_ids"]
    categories = selection["categories"]
    if (
        not isinstance(cell_ids, list) or not cell_ids
        or any(not isinstance(v, str) or not v for v in cell_ids)
        or cell_ids != sorted(set(cell_ids))
    ):
        raise ValueError("selection.cell_ids must be a nonempty sorted unique string array")
    if (
        not isinstance(categories, list) or not categories
        or len(categories) != len(set(categories))
        or not set(categories).issubset(REPLAY_CATEGORIES)
    ):
        raise ValueError(
            f"selection.categories must be a nonempty unique subset of {REPLAY_CATEGORIES}"
        )

    oracle = _require_exact_keys(
        config["oracle"],
        {
            "absolute", "relative", "veto_budget", "sensitivity_grid",
            "decimal_precision",
        },
        label="oracle replay oracle",
    )
    for name in ("absolute", "relative"):
        value = oracle[name]
        if isinstance(value, bool) or not isinstance(value, (int, float)) or not np.isfinite(value) or value < 0:
            raise ValueError(f"oracle.{name} must be a finite nonnegative number")
    veto_budget = oracle["veto_budget"]
    if veto_budget is not None and (
        isinstance(veto_budget, bool) or not isinstance(veto_budget, int) or veto_budget <= 0
    ):
        raise ValueError("oracle.veto_budget must be null or a positive integer")
    if {
        "relative": oracle["relative"],
        "absolute": oracle["absolute"],
    } != ORACLE_PRIMARY_TOLERANCE:
        raise ValueError(
            "oracle operational tolerance differs from the preregistered primary pair"
        )
    if (
        isinstance(oracle["decimal_precision"], bool)
        or not isinstance(oracle["decimal_precision"], int)
        or oracle["decimal_precision"] != ORACLE_DECIMAL_PRECISION
    ):
        raise ValueError(
            f"oracle.decimal_precision must be {ORACLE_DECIMAL_PRECISION}"
        )
    if config["oracle"]["sensitivity_grid"] != list(
        ORACLE_TOLERANCE_SENSITIVITY
    ):
        raise ValueError(
            "oracle.sensitivity_grid differs from the preregistered grid"
        )
    if config["arms"] != list(ORACLE_ARMS):
        raise ValueError(f"oracle replay arms must be exactly {list(ORACLE_ARMS)}")

    decoder = _require_exact_keys(
        config["decoder"],
        {"residual_hw_limit", "domain_mode", "boundary_policy", "observable_policy"},
        label="oracle replay decoder",
    )
    if (
        isinstance(decoder["residual_hw_limit"], bool)
        or not isinstance(decoder["residual_hw_limit"], int)
        or decoder["residual_hw_limit"] < 0
    ):
        raise ValueError("decoder.residual_hw_limit must be a nonnegative integer")
    if decoder["domain_mode"] not in ("windowd", "fullhistory"):
        raise ValueError("decoder.domain_mode is unsupported")
    if decoder["boundary_policy"] not in ("disabled", "odd-parity"):
        raise ValueError("decoder.boundary_policy is unsupported")
    if decoder["observable_policy"] not in ("zero-frame", "edge-zero", "path-zero", "any"):
        raise ValueError("decoder.observable_policy is unsupported")

    implementation = _require_exact_keys(
        config["implementation"], {"repository_commit", "source_hashes"},
        label="oracle replay implementation",
    )
    commit = implementation["repository_commit"]
    if not isinstance(commit, str) or len(commit) != 40:
        raise ValueError("implementation.repository_commit must be a full Git commit hash")
    try:
        bytes.fromhex(commit)
    except ValueError as ex:
        raise ValueError("implementation.repository_commit is not hexadecimal") from ex
    hashes = implementation["source_hashes"]
    required_sources = {
        "tools/diagnose_promatch_l1",
        "src/yoked/decoding/_promatch.py",
        "src/yoked/decoding/_promatch_experiment.py",
        "src/yoked/decoding/_promatch_graph.py",
        "src/yoked/decoding/_promatch_layout.py",
        "src/yoked/decoding/_promatch_oracle.py",
        "src/yoked/decoding/_promatch_oracle_replay.py",
        "requirements.txt",
    }
    _require_exact_keys(hashes, required_sources, label="implementation.source_hashes")
    for relpath, expected in hashes.items():
        if not isinstance(expected, str) or len(expected) != 64:
            raise ValueError(f"source hash for {relpath!r} must be 64 hex characters")
        source = (_ROOT / relpath).resolve()
        if not source.is_relative_to(_ROOT) or not source.is_file():
            raise ValueError(f"frozen source path is missing or outside the repository: {relpath!r}")
        if _sha256_file(source) != expected:
            raise ValueError(f"frozen source hash mismatch for {relpath!r}")
    return config


def _validate_clean_implementation(
    config: dict[str, Any], *, config_path: Path
) -> dict[str, Any]:
    if _git_output("status", "--porcelain", "--untracked-files=all"):
        raise ValueError("oracle replay requires a clean worktree")
    head = _git_output("rev-parse", "HEAD")
    commit = config["implementation"]["repository_commit"]
    ancestry = subprocess.run(
        ("git", "-C", str(_ROOT), "merge-base", "--is-ancestor", commit, head),
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )
    if ancestry.returncode != 0:
        raise ValueError("frozen implementation commit is not an ancestor of HEAD")
    resolved_config = config_path.resolve()
    if not resolved_config.is_relative_to(_ROOT):
        raise ValueError("frozen oracle replay config must be inside the repository")
    config_relpath = resolved_config.relative_to(_ROOT).as_posix()
    changed = tuple(
        line for line in _git_output("diff", "--name-only", f"{commit}..{head}").splitlines()
        if line
    )
    if changed != (config_relpath,):
        raise ValueError(
            "post-implementation commits must change exactly the frozen config; "
            f"expected {[config_relpath]}, got {list(changed)}"
        )
    return {
        "repository_head": head,
        "implementation_commit": commit,
        "clean_worktree": True,
        "post_implementation_changed_paths": list(changed),
    }


