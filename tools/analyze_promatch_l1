#!/usr/bin/env python3
"""Validate and analyze fixed-shot paired L1 ProMatch ledgers."""

from __future__ import annotations

import os

for _name in (
    "OMP_NUM_THREADS",
    "OPENBLAS_NUM_THREADS",
    "MKL_NUM_THREADS",
    "NUMEXPR_NUM_THREADS",
    "VECLIB_MAXIMUM_THREADS",
    "BLIS_NUM_THREADS",
):
    os.environ[_name] = "1"

import argparse
import json
from pathlib import Path
import sys
import tempfile

_ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(_ROOT / "src"))

from yoked.decoding._promatch_analysis import (  # noqa: E402
    analyze_summary,
    load_verified_summary,
    render_markdown,
    validate_generated_analysis_artifact,
)
from yoked.decoding._promatch_experiment import normalize_protocol  # noqa: E402
from yoked.decoding._promatch_latency_analysis import (  # noqa: E402
    TinyLatencyAnalysisConfig,
    analyze_latency_suite,
    render_latency_markdown,
)
from yoked.decoding._promatch_latency_integration import (  # noqa: E402
    TinyLatencySmokeConfig,
)


def _unique_object(pairs):
    result = {}
    for key, value in pairs:
        if key in result:
            raise ValueError(f"duplicate JSON object key {key!r}")
        result[key] = value
    return result


def _load_json(path: Path):
    with path.open(encoding="utf-8") as f:
        return json.load(f, object_pairs_hook=_unique_object)


def _atomic_write(path: Path, data: bytes, *, overwrite: bool) -> None:
    if path.exists() and not overwrite:
        raise FileExistsError(f"refusing to overwrite {path}; pass --overwrite")
    scratch = os.environ.get("TMPDIR")
    if not scratch:
        raise RuntimeError("TMPDIR must be set for atomic analysis writes")
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, temporary = tempfile.mkstemp(prefix="promatch-analysis-", dir=scratch)
    try:
        with os.fdopen(fd, "wb") as f:
            f.write(data)
            f.flush()
            os.fsync(f.fileno())
        os.replace(temporary, path)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Fail-closed paired accuracy/workload analysis for L1 ProMatch"
    )
    parser.add_argument("--protocol", type=Path, required=True)
    parser.add_argument("--input", type=Path)
    parser.add_argument("--latency-input", type=Path)
    parser.add_argument("--latency-cell")
    parser.add_argument(
        "--out",
        type=Path,
        required=True,
        help="separate analysis directory (must not be the collection directory)",
    )
    parser.add_argument(
        "--allow-non-scientific",
        action="store_true",
        help="analyze a smoke result without permitting claim-bearing language",
    )
    parser.add_argument("--overwrite", action="store_true")
    args = parser.parse_args()
    try:
        manifest = _load_json(args.protocol)
        if args.input is None and args.latency_input is None:
            raise ValueError("at least one of --input or --latency-input is required")
        if args.input is not None and args.latency_input is not None:
            raise ValueError(
                "accuracy and latency analyses require separate invocations/output directories"
            )
        if (args.latency_input is None) != (args.latency_cell is None):
            raise ValueError("--latency-input and --latency-cell must be provided together")
        normalized = normalize_protocol(manifest)
        if args.allow_non_scientific:
            if (
                normalized.get("phase") != "smoke"
                or normalized.get("claim_bearing") is not False
            ):
                raise ValueError(
                    "--allow-non-scientific is restricted to non-claim-bearing smoke protocols"
                )
        output = args.out.resolve()
        collection_inputs = [
            value.resolve()
            for value in (args.input, args.latency_input)
            if value is not None
        ]
        if any(
            source == output
            or source in output.parents
            or output in source.parents
            for source in collection_inputs
        ):
            raise ValueError(
                "--out and collection inputs must be separate, non-nested directories"
            )
        expected_output_names = (
            {"latency_analysis.json", "latency_analysis.md"}
            if args.latency_input is not None
            else {
                "analysis.json",
                "analysis.md",
                *(
                    ("pilot_selection.json",)
                    if normalized.get("phase") == "pilot"
                    else ()
                ),
            }
        )
        if output.exists():
            if not output.is_dir() or output.is_symlink():
                raise ValueError("--out must be a regular directory")
            actual_output_names = {entry.name for entry in output.iterdir()}
            if actual_output_names != expected_output_names:
                raise ValueError(
                    "existing --out does not contain the exact analysis artifact set"
                )
            if not args.overwrite:
                raise FileExistsError(
                    "analysis artifacts already exist; pass --overwrite to replace them"
                )
        if args.input is not None:
            summary = load_verified_summary(
                manifest=manifest,
                input_directory=args.input.resolve(),
                scientific=not args.allow_non_scientific,
            )
            analysis = analyze_summary(summary, manifest=manifest)
            validate_generated_analysis_artifact(analysis)
            json_data = (
                json.dumps(analysis, sort_keys=True, indent=2, allow_nan=False)
                + "\n"
            ).encode("utf-8")
            _atomic_write(output / "analysis.json", json_data, overwrite=args.overwrite)
            _atomic_write(
                output / "analysis.md",
                (render_markdown(analysis) + "\n").encode("utf-8"),
                overwrite=args.overwrite,
            )
            if "blinded_selection" in analysis:
                selection_data = (
                    json.dumps(
                        analysis["blinded_selection"],
                        sort_keys=True,
                        indent=2,
                        allow_nan=False,
                    )
                    + "\n"
                ).encode("utf-8")
                _atomic_write(
                    output / "pilot_selection.json",
                    selection_data,
                    overwrite=args.overwrite,
                )
            print(f"wrote {output / 'analysis.json'}")
            print(f"wrote {output / 'analysis.md'}")
        if args.latency_input is not None:
            smoke = (
                TinyLatencyAnalysisConfig(collection=TinyLatencySmokeConfig())
                if args.allow_non_scientific
                else None
            )
            latency_analysis = analyze_latency_suite(
                args.latency_input.resolve(),
                manifest=manifest,
                cell_id=args.latency_cell,
                scientific=not args.allow_non_scientific,
                smoke=smoke,
            )
            _atomic_write(
                output / "latency_analysis.json",
                (
                    json.dumps(
                        latency_analysis,
                        sort_keys=True,
                        indent=2,
                        allow_nan=False,
                    )
                    + "\n"
                ).encode("utf-8"),
                overwrite=args.overwrite,
            )
            _atomic_write(
                output / "latency_analysis.md",
                (render_latency_markdown(latency_analysis) + "\n").encode("utf-8"),
                overwrite=args.overwrite,
            )
            print(f"wrote {output / 'latency_analysis.json'}")
            print(f"wrote {output / 'latency_analysis.md'}")
        return 0
    except (ValueError, TypeError, RuntimeError, OSError, KeyError) as ex:
        print(f"error: {ex}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
