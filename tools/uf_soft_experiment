#!/usr/bin/env python3
"""Compare UF-only confidence estimators on verified, saved hierarchical shots."""
import argparse
from pathlib import Path
import sys

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / 'src'))
from yoked.hierarchical._uf_soft_analysis import analyze
from yoked.hierarchical._uf_soft_collect import collect_features


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    stages = parser.add_subparsers(dest='stage', required=True)
    collect = stages.add_parser('collect')
    collect.add_argument('--record', required=True)
    collect.add_argument('--out', required=True)
    collect.add_argument('--workers', type=int, default=1)
    collect.add_argument('--chunk-size', type=int, default=64)
    collect.add_argument('--limit', type=int)
    collect.add_argument('--sample-dir', help='saved sample directory, default RECORD/sample')
    compare = stages.add_parser('analyze')
    compare.add_argument('--calibration-record', required=True)
    compare.add_argument('--evaluation-record', required=True)
    compare.add_argument('--calibration-features', required=True)
    compare.add_argument('--evaluation-features', required=True)
    compare.add_argument('--out', required=True)
    args = vars(parser.parse_args())
    stage = args.pop('stage')
    if stage == 'collect':
        args['record_dir'] = args.pop('record')
        args['output_dir'] = args.pop('out')
        collect_features(**args)
    else:
        args['output_dir'] = args.pop('out')
        result = analyze(**args)
        for name, row in result['methods'].items():
            print(f"{name}: {row['failures']}/{row['shots']}, LER={row['normalized_ler']:.9g}")


if __name__ == '__main__':
    main()
