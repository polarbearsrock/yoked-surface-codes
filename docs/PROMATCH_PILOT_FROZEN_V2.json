{
  "analysis_config": {
    "output_schema": {
      "aggregate_required_fields": [
        "shots",
        "paired_contingency.{both_correct,regressions,recoveries,both_wrong}",
        "activated_shots",
        "activated_domains",
        "initial_detector_events",
        "residual_detector_events",
        "success_shots",
        "rollback_shots",
        "stage_attempts",
        "stage_commits",
        "original_residual_hw_joint_histogram"
      ],
      "batch_ledger_required_fields": [
        "experiment_id",
        "cell_id",
        "phase",
        "batch.{batch_id,shot_start,shots}",
        "stim_seed",
        "detectors.{shape,dtype,sha256}",
        "observables.{shape,dtype,sha256}",
        "provenance",
        "paired_contingency",
        "telemetry",
        "replay_samples"
      ],
      "bounded_replay_policy": {
        "batch_ledger_selection": "lowest_selection_sha256_within_batch_and_category",
        "categories": [
          "regression",
          "recovery",
          "rollback"
        ],
        "cell_summary_selection": "lowest_selection_sha256_across_batch_candidates_within_cell_and_category",
        "equal_cap_prefilter_equivalence": true,
        "invariant_violation_policy": "fatal_run_error_no_replay_row",
        "maximum_candidate_rows_per_category_per_batch_ledger": 100,
        "maximum_retained_rows_per_category_per_cell_summary": 100,
        "must_be_replayable": true,
        "selection_key": "SHA256_ASCII(cell_id:batch_id:shot_index:category)"
      },
      "integrity": "reject missing or duplicate ranges, digest mismatches, nonreconciling counts, wrong fixed N, or manifest-hash mismatches",
      "required_files": [
        "experiment.json",
        "protocol.json",
        "batches/<cell_id>/batch-<batch_id>.json",
        "summary.json",
        "analysis.json",
        "analysis.md",
        "pilot_selection.json"
      ],
      "schema_version": 2
    },
    "selection_gates": {
      "forbidden_selection_inputs": [
        "regressions_minus_recoveries",
        "signed_accuracy_difference",
        "treatment_better_direction"
      ],
      "maximum_confirmatory_paired_shots": 10000000,
      "minimum_activation_fraction": 0.05,
      "minimum_confirmatory_power": 0.9,
      "minimum_discordant_pairs": 100,
      "minimum_u0_direct_failures": 200,
      "no_qualifying_cell_result": "accuracy_confirmation_infeasible",
      "require_integrity_checks": true
    },
    "statistical_design": {
      "discordance_upper_method": "one-sided 95 percent Clopper-Pearson",
      "equality_method_secondary": "exact McNemar",
      "noninferiority_alpha_one_sided": 0.025,
      "noninferiority_margin_rule": "delta_NI = 0.05 * p_U0_design",
      "normal_rule_z_alpha": 1.959963984540054,
      "normal_rule_z_power": 1.2815515655446004,
      "paired_difference": "Delta = p_PU - p_U0 = (regressions - recoveries) / N",
      "power_verification": {
        "accept_if_lower_bound_at_least": 0.9,
        "confidence_method": "one-sided 95 percent Clopper-Pearson lower bound",
        "increment_shots": 10000,
        "maximum_shots": 10000000,
        "multinomial_probabilities": "[q_U/2, q_U/2, 1-q_U]",
        "power_bound_alpha": 0.05,
        "replicates": 100000,
        "rng": "numpy.default_rng",
        "seed": 1618033988749894
      },
      "primary_confidence_bound": "one-sided 97.5 percent upper",
      "primary_method": "Tango paired efficient-score upper confidence bound",
      "primary_outcome": "any_observable_shot_failure",
      "sample_size_rounding": 10000,
      "stopping_rule": "fixed_shots_only; MAX_ERRORS and result-dependent stopping are forbidden",
      "tango_solver": {
        "maximum_iterations": 200,
        "parameter_bracket": {
          "lower": "observed_delta",
          "upper": "numpy.nextafter(1.0, 0.0)"
        },
        "root_finder": "scipy.optimize.brentq",
        "xtol": 1e-12,
        "zero_discordance": "profiled_boundary_z_squared_over_N_plus_z_squared"
      }
    },
    "timing_protocol": {
      "block_order": "randomized_balanced_AB_BA",
      "bootstrap_clusters": [
        "process_restart",
        "paired_block"
      ],
      "bootstrap_replicates": 10000,
      "calls_per_decoder_per_block": 100,
      "clock": "time.perf_counter_ns",
      "gates": {
        "backend_geometric_ratio_upper": 0.9,
        "total_geometric_ratio_upper": 0.95,
        "total_p99_ratio_upper": 1.05
      },
      "input_generation": "pregenerated_outside_timed_regions",
      "paired_blocks_per_restart": 100,
      "primary_mode_batch_size": 1,
      "process_restarts": 10,
      "quantile_method": "empirical_type_7",
      "restart_concurrency": 1,
      "scope": "recorded now so pilot outcomes cannot tune confirmatory timing",
      "secondary_batch_sizes": [
        64,
        1024
      ],
      "three_way_order": "balanced_Latin_square",
      "timing_corpus_reuse_policy": "cycle_pregenerated_natural_noise_corpus",
      "timing_corpus_shots_per_restart": 10000,
      "upper_confidence_percentile": 97.5,
      "warmup_calls_per_decoder_per_restart": 1000
    },
    "workload_protocol": {
      "bootstrap_alpha_one_sided": 0.025,
      "bootstrap_unit": "paired_shot_via_exact_joint_histogram_multinomial",
      "conditioning": "unconditional",
      "paired_bootstrap_replicates": 10000,
      "primary_estimand": "mean residual detector events / mean original detector events over all shots",
      "quantile_method": "empirical_type_7",
      "workload_ratio_upper_threshold": 0.9
    }
  },
