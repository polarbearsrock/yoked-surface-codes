    "relative_risk": "secondary; undefined when holdout U0 failures are zero",
    "tango_solver": {
      "root_finder": "scipy.optimize.brentq",
      "parameter_bracket": {
        "lower": "observed_delta",
        "upper": "numpy.nextafter(1.0, 0.0)"
      },
      "xtol": 1e-12,
      "maximum_iterations": 200,
      "zero_discordance": "profiled_boundary_z_squared_over_N_plus_z_squared"
    },
    "fixed_stopping": "collect exactly n_confirm paired shots; MAX_ERRORS and result-dependent stopping are forbidden",
    "exclusions": "none by decoder result; crashes, invariant failures, and malformed output fail the run"
  },
