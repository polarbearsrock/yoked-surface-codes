    "serialized_dem_sha256_by_cell": null,
    "compiled_graph_fingerprint_by_cell": null
  },
  "decoders": {
    "u0_direct": {
      "name": "pymatching",
      "role": "primary_causal_baseline"
    },
    "u0_wrap": {
      "name": "pymatching-u0-wrap-v1-windowd",
      "role": "adapter_overhead_control"
    },
    "pu_window": {
      "name": "promatch-l1-v1-windowd-hw10-stages1234-noboundary-zeroframe-pymatching",
      "role": "primary_treatment",
      "configuration": {
        "domain_mode": "windowd",
        "residual_hw_limit": 10,
        "stages": [1, 2, 3, 4],
        "boundary_policy": "disabled",
        "observable_policy": "zero-frame",
        "residual_backend": "pymatching"
      }
    },
    "pu_boundary": {
      "name": "promatch-l1-v1-windowd-hw10-stages1234-parityboundary-zeroframe-pymatching",
      "role": "deferred_exploratory_not_required_in_v3"
    },
    "pu_full": {
      "name": "promatch-l1-v1-fullhistory-hw10-stages1234-noboundary-zeroframe-pymatching",
      "role": "diagnostic_only"
    },
    "c0_context": {
      "name": "pymatching-correlated",
      "role": "descriptive_context_only"
    }
  },
  "pilot": {
    "shots_per_cell": 200000,
